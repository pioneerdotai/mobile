 import com.swmansion.enriched.markdown.spans.LinkSpan
 import com.swmansion.enriched.markdown.utils.text.span.SPAN_FLAGS_EXCLUSIVE_EXCLUSIVE
+import kotlin.math.roundToInt
+
+private const val LINK_ICON_PLACEHOLDER = "\uFFFC"
+private const val LINK_ICON_SIZE_SCALE = 0.85f
+private const val LINK_ICON_GAP_SCALE = 0.15f
+private val WINDOWS_DRIVE_PATH = Regex("^[A-Za-z]:[\\\\/]")
+
+private fun isLocalFileUrl(url: String): Boolean =
+  url.startsWith("file://", ignoreCase = true) ||
+    url.startsWith("/") ||
+    url.startsWith("\\\\") ||
+    WINDOWS_DRIVE_PATH.containsMatchIn(url)
+
+private fun MarkdownASTNode.hasLinkDescendant(): Boolean =
+  children.any { child -> child.type == MarkdownASTNode.NodeType.Link || child.hasLinkDescendant() }
+
+private class LinkIconSpan(
+  context: Context,
+  private val url: String,
+  private val styleCache: SpanStyleCache,
+  private val blockStyle: BlockStyle,
+) : ReplacementSpan() {
+  private val iconSize = blockStyle.fontSize * LINK_ICON_SIZE_SCALE
+  private val reservedWidth = iconSize + blockStyle.fontSize * LINK_ICON_GAP_SCALE
+  private val icon = context.getDrawable(
+    if (isLocalFileUrl(url)) R.drawable.enrm_link_file else R.drawable.enrm_link_globe,
+  )?.mutate()
+
+  override fun getSize(
+    paint: Paint,
+    text: CharSequence?,
+    start: Int,
+    end: Int,
+    fontMetrics: Paint.FontMetricsInt?,
+  ): Int = reservedWidth.roundToInt()
+
+  override fun draw(
+    canvas: Canvas,
+    text: CharSequence?,
+    start: Int,
+    end: Int,
+    x: Float,
+    top: Int,
+    y: Int,
+    bottom: Int,
+    paint: Paint,
+  ) {
+    val drawable = icon ?: return
+    if (iconSize <= 0f) return
+    val centerY = y + (paint.ascent() + paint.descent()) / 2f
+    val iconTop = centerY - iconSize / 2f
+    val color = styleCache.resolvedVariantForUrl(url)?.color ?: styleCache.linkColor
+    val left = x.roundToInt()
+    val topOffset = iconTop.roundToInt()
+    val size = iconSize.roundToInt()
+    drawable.setTint(color)
+    drawable.setBounds(left, topOffset, left + size, topOffset + size)
+    drawable.draw(canvas)
+  }
+}
 
