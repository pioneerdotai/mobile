diff --git a/ios/renderer/LinkRenderer.m b/ios/renderer/LinkRenderer.m
index 5fdc4a7..1058273 100644
--- a/ios/renderer/LinkRenderer.m
+++ b/ios/renderer/LinkRenderer.m
@@ -5,6 +5,113 @@
 #import "StyleConfig.h"
 #import <React/RCTFont.h>
 
+static const CGFloat kLinkIconSizeScale = 0.85;
+static const CGFloat kLinkIconGapScale = 0.15;
+
+static BOOL LinkNodeHasLinkDescendant(MarkdownASTNode *node)
+{
+  for (MarkdownASTNode *child in node.children) {
+    if (child.type == MarkdownNodeTypeLink || LinkNodeHasLinkDescendant(child))
+      return YES;
+  }
+  return NO;
+}
+
+static BOOL LinkURLIsLocalFile(NSString *url)
+{
+  if ([url hasPrefix:@"/"] || [url hasPrefix:@"\\\\"] ||
+      [url rangeOfString:@"file://" options:NSAnchoredSearch | NSCaseInsensitiveSearch].location != NSNotFound)
+    return YES;
+  if (url.length < 3)
+    return NO;
+  unichar first = [url characterAtIndex:0];
+  unichar separator = [url characterAtIndex:2];
+  return ((first >= 'A' && first <= 'Z') || (first >= 'a' && first <= 'z')) &&
+      [url characterAtIndex:1] == ':' && (separator == '/' || separator == '\\');
+}
+
+static RCTUIImage *LinkAsset(NSString *url, RCTUIColor *color)
+{
+  NSBundle *hostBundle = [NSBundle bundleForClass:[LinkRenderer class]];
+  NSURL *bundleURL = [hostBundle URLForResource:@"EnrichedMarkdownLinkAssets" withExtension:@"bundle"];
+  NSBundle *assetBundle = bundleURL ? [NSBundle bundleWithURL:bundleURL] : nil;
+  RCTUIImage *image = [RCTUIImage imageNamed:LinkURLIsLocalFile(url) ? @"LinkFile" : @"LinkGlobe"
+                                   inBundle:assetBundle
+              compatibleWithTraitCollection:nil];
+  return image ? [image imageWithTintColor:color renderingMode:UIImageRenderingModeAlwaysOriginal] : nil;
+}
+
+static NSAttributedString *LinkIconAttributedString(BlockStyle *blockStyle,
+                                                    CGFloat fallbackFontSize,
+                                                    UIFont *fallbackFont,
+                                                    NSString *url,
+                                                    RCTUIColor *color)
+{
+#if !TARGET_OS_OSX
+  CGFloat fontSize = blockStyle.fontSize > 0 ? blockStyle.fontSize : fallbackFontSize;
+  fontSize = fontSize > 0 ? fontSize : 14.0;
+  color = color ?: blockStyle.color ?: [RCTUIColor linkColor];
+
+  CGFloat iconSize = fontSize * kLinkIconSizeScale;
+  CGFloat gap = fontSize * kLinkIconGapScale;
+  CGSize imageSize = CGSizeMake(iconSize + gap, iconSize);
+  CGFloat scale = iconSize / 24.0;
+  RCTUIGraphicsImageRenderer *renderer = ImageRendererForSize(imageSize);
+  RCTUIImage *image = [renderer imageWithActions:^(RCTUIGraphicsImageRendererContext *rendererContext) {
+    RCTUIImage *asset = LinkAsset(url, color);
+    if (!asset) {
+      UIImageSymbolConfiguration *configuration =
+          [UIImageSymbolConfiguration configurationWithPointSize:iconSize weight:UIImageSymbolWeightRegular];
+      NSString *systemName = LinkURLIsLocalFile(url) ? @"doc" : @"globe";
+      asset = [[RCTUIImage systemImageNamed:systemName withConfiguration:configuration]
+          imageWithTintColor:color
+               renderingMode:UIImageRenderingModeAlwaysOriginal];
+    }
+    if (asset) {
+      [asset drawInRect:CGRectMake(0, 0, iconSize, iconSize)];
+      return;
+    }
+
+    [color setStroke];
+
+    UIBezierPath *outer = [UIBezierPath bezierPathWithOvalInRect:CGRectMake(2.0 * scale,
+                                                                           2.0 * scale,
+                                                                           20.0 * scale,
+                                                                           20.0 * scale)];
+    outer.lineWidth = MAX(1.0, 2.0 * scale);
+    BezierPathSetRoundStyle(outer);
+    [outer stroke];
+
+    UIBezierPath *meridian = [UIBezierPath bezierPathWithOvalInRect:CGRectMake(8.0 * scale,
+                                                                              2.0 * scale,
+                                                                              8.0 * scale,
+                                                                              20.0 * scale)];
+    meridian.lineWidth = outer.lineWidth;
+    BezierPathSetRoundStyle(meridian);
+    [meridian stroke];
+
+    UIBezierPath *equator = [UIBezierPath bezierPath];
+    [equator moveToPoint:CGPointMake(2.0 * scale, 12.0 * scale)];
+    BezierPathAddLine(equator, CGPointMake(22.0 * scale, 12.0 * scale));
+    equator.lineWidth = outer.lineWidth;
+    BezierPathSetRoundStyle(equator);
+    [equator stroke];
+  }];
+
+  UIFont *font = blockStyle.cachedFont ?: fallbackFont ?: [UIFont systemFontOfSize:fontSize];
+  NSTextAttachment *attachment = [[NSTextAttachment alloc] init];
+  attachment.image = image;
+  attachment.bounds = CGRectMake(0, (font.capHeight - iconSize) / 2.0, imageSize.width, imageSize.height);
+
+  NSMutableAttributedString *value =
+      [[NSMutableAttributedString alloc] initWithAttributedString:[NSAttributedString attributedStringWithAttachment:attachment]];
+  [value appendAttributedString:[[NSAttributedString alloc] initWithString:@"\u2060"]];
+  return value;
+#else
+  return nil;
+#endif
+}
+
