+private const val LINK_ICON_PLACEHOLDER = "\uFFFC"
+private const val LINK_ICON_SIZE_SCALE = 0.85f
+private const val LINK_ICON_GAP_SCALE = 0.15f
+
+private fun MarkdownASTNode.hasLinkDescendant(): Boolean =
