{
    "name": "pioneer-app",
    "private": true,
    "workspaces": [
        "modules/pioneer-client-nitro"
    ],
    "main": "index.ts",
    "scripts": {
        "start": "expo start",
        "android": "expo run:android",
        "ios": "expo run:ios",
        "lint": "bunx expo lint",
        "prebuild:ios": "expo prebuild -p ios --clean",
        "prebuild:android": "expo prebuild -p android --clean",
        "build:ios": "eas build --platform ios --profile development",
        "build:android": "eas build --platform android --profile development",
        "release:ios": "eas build --platform ios --profile production --auto-submit",
        "release:android": "eas build --platform android --profile production",
        "eas-build-pre-install": "bash modules/pioneer-client-nitro/scripts/eas-prepare-rust.sh",
        "update:all": "eas update --channel production --environment production && npx sentry-expo-upload-sourcemaps dist",
        "client": "bun run client:schema && bun run client:types",
        "client:schema": "tsx ./scripts/export-client-schema.ts",
        "client:types": "tsx ./scripts/generate-client-types.ts",
        "client:check": "tsx ./scripts/check-client-contract.ts",
        "locale": "tsx ./scripts/generate-translations.ts",
        "nitro:generate": "cd modules/pioneer-client-nitro && nitrogen",
        "rust:build:ios": "env PIONEER_CLIENT_RUST_MODE=source bash modules/pioneer-client-nitro/scripts/build-rust-ios.sh",
        "rust:build:android": "env PIONEER_CLIENT_RUST_MODE=source bash modules/pioneer-client-nitro/scripts/build-rust-android.sh",
        "rust:build:prebuilt": "bun run rust:build:ios && bun run rust:build:android",
        "rust:check:ios": "bash modules/pioneer-client-nitro/scripts/check-rust-prebuilt.sh ios",
        "rust:check:android": "bash modules/pioneer-client-nitro/scripts/check-rust-prebuilt.sh android",
        "rust:check:prebuilt": "bash modules/pioneer-client-nitro/scripts/check-rust-prebuilt.sh all"
    },
    "jest": {
        "preset": "jest-expo",
        "moduleNameMapper": {
            "^@/(.*)$": "<rootDir>/src/$1"
        }
    },
    "expo": {
        "doctor": {
            "reactNativeDirectoryCheck": {
                "exclude": [
                    "lodash",
                    "nanoid",
                    "nanoid-dictionary",
                    "qs",
                    "immer"
                ]
            }
        },
        "install": {
            "exclude": [
                "@sentry/react-native",
                "react-native-keyboard-controller"
            ]
        }
    },
    "dependencies": {
        "@gorhom/bottom-sheet": "^5.2.14",
        "@hookform/resolvers": "^5.4.0",
        "@legendapp/list": "^3.0.4",
        "@pioneer/client-nitro": "workspace:*",
        "@react-native-async-storage/async-storage": "2.2.0",
        "@sentry/react-native": "^8.14.0",
        "@shopify/flash-list": "2.0.2",
        "@tanstack/react-query": "^5.101.0",
        "dayjs": "^1.11.21",
        "dset": "^3.1.4",
        "expo": "^56.0.11",
        "expo-application": "^56.0.3",
        "expo-asset": "^56.0.17",
        "expo-background-task": "^56.0.18",
        "expo-clipboard": "~56.0.4",
        "expo-constants": "^56.0.18",
        "expo-dev-client": "^56.0.20",
        "expo-device": "^56.0.4",
        "expo-document-picker": "~56.0.4",
        "expo-file-system": "~56.0.8",
        "expo-font": "^56.0.6",
        "expo-haptics": "^56.0.3",
        "expo-image-picker": "~56.0.17",
        "expo-linking": "^56.0.14",
        "expo-localization": "^56.0.6",
        "expo-network": "^56.0.5",
        "expo-notifications": "^56.0.17",
        "expo-router": "^56.2.10",
        "expo-screen-orientation": "^56.0.5",
        "expo-secure-store": "~56.0.4",
        "expo-splash-screen": "^56.0.10",
        "expo-status-bar": "^56.0.4",
        "expo-store-review": "^56.0.3",
        "expo-system-ui": "^56.0.5",
        "expo-task-manager": "^56.0.18",
        "expo-updates": "^56.0.19",
        "i18next": "^26.3.1",
        "immer": "^11.1.8",
        "intl-pluralrules": "^2.0.1",
        "lodash": "^4.18.1",
        "lucide-react-native": "^1.18.0",
        "nanoid": "^5.1.11",
        "nanoid-dictionary": "^5.0.0",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-hook-form": "^7.78.0",
        "react-i18next": "^17.0.8",
        "react-native": "0.85.3",
        "react-native-drax": "^1.1.0",
        "react-native-edge-to-edge": "^1.8.1",
        "react-native-gesture-handler": "~2.31.1",
        "react-native-get-random-values": "~1.11.0",
        "react-native-keyboard-controller": "1.21.11",
        "react-native-mmkv": "^4.3.1",
        "react-native-nitro-modules": "^0.35.9",
        "react-native-permissions": "^5.5.3",
        "react-native-reanimated": "4.3.1",
        "react-native-safe-area-context": "~5.7.0",
        "react-native-screens": "~4.25.2",
        "react-native-svg": "15.15.4",
        "react-native-unistyles": "^3.2.5",
        "react-native-worklets": "0.8.3",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@tanstack/eslint-plugin-query": "^5.101.0",
        "@types/bun": "^1.3.14",
        "@types/fs-extra": "^11.0.4",
        "@types/lodash": "^4.17.24",
        "@types/react": "^19.2.17",
        "babel-plugin-react-compiler": "^1.0.0",
        "babel-preset-expo": "^56.0.15",
        "eslint": "^9.39.4",
        "eslint-config-expo": "^56.0.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react-compiler": "^19.1.0-rc.2",
        "expo-build-properties": "^56.0.18",
        "fs-extra": "^11.3.5",
        "jest": "~29.7.0",
        "jest-expo": "^56.0.5",
        "json-schema-to-typescript": "^15.0.4",
        "nitrogen": "^0.35.9",
        "prettier": "^3.8.4",
        "react-test-renderer": "^19.2.7",
        "tsx": "^4.22.4",
        "typescript": "~6.0.3"
    },
    "overrides": {
        "zod-validation-error": "^4.0.2"
    },
    "trustedDependencies": [
        "@sentry/cli"
    ]
}
