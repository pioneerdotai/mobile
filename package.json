{
    "name": "pioneer-app",
    "private": true,
    "workspaces": [
        "modules/pioneer-client-nitro"
    ],
    "main": "index.ts",
    "scripts": {
        "start": "expo start",
        "android": "expo run:android",
        "ios": "expo run:ios",
        "lint": "bunx expo lint",
        "prebuild:ios": "expo prebuild -p ios --clean",
        "prebuild:android": "expo prebuild -p android --clean",
        "build:ios": "eas build --platform ios --profile development --clear-cache",
        "build:android": "eas build --platform android --profile development --clear-cache",
        "release:ios": "eas build --platform ios --profile production --clear-cache --auto-submit",
        "release:android": "eas build --platform android --profile production --clear-cache",
        "postinstall": "node scripts/install-enriched-markdown-assets.mjs",
        "eas-build-pre-install": "bash modules/pioneer-client-nitro/scripts/eas-prepare-rust.sh",
        "update:all": "eas update --channel production --environment production --clear-cache && npx sentry-expo-upload-sourcemaps dist",
        "client": "bun run client:schema && bun run client:types && bun run client:contract",
        "client:schema": "tsx ./scripts/export-client-schema.ts",
        "client:types": "tsx ./scripts/generate-client-types.ts",
        "client:contract": "PIONEER_RUST_ROOT=\"${PIONEER_RUST_ROOT:-../pioneer}\" node modules/pioneer-client-nitro/scripts/boundary-integrity.mjs source",
        "client:check": "tsx ./scripts/check-client-contract.ts",
        "locale": "tsx ./scripts/generate-translations.ts",
        "nitro:generate": "cd modules/pioneer-client-nitro && nitrogen",
        "rust:build:ios": "env PIONEER_CLIENT_RUST_MODE=source bash modules/pioneer-client-nitro/scripts/build-rust-ios.sh",
        "rust:build:android": "env PIONEER_CLIENT_RUST_MODE=source bash modules/pioneer-client-nitro/scripts/build-rust-android.sh",
        "rust:build:prebuilt": "bun run rust:build:ios && bun run rust:build:android",
        "rust:check:ios": "bash modules/pioneer-client-nitro/scripts/check-rust-prebuilt.sh ios",
        "rust:check:android": "bash modules/pioneer-client-nitro/scripts/check-rust-prebuilt.sh android",
        "rust:check:prebuilt": "bash modules/pioneer-client-nitro/scripts/check-rust-prebuilt.sh all"
    },
    "jest": {
        "preset": "jest-expo",
        "roots": [
            "<rootDir>/src"
        ],
        "transformIgnorePatterns": [
            "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|nanoid|react-native-otp-entry))",
            "/node_modules/react-native-reanimated/plugin/",
            "/node_modules/@react-native/babel-preset/"
        ],
        "moduleNameMapper": {
            "^@/(.*)$": "<rootDir>/src/$1"
        }
    },
    "expo": {
        "doctor": {
            "reactNativeDirectoryCheck": {
                "exclude": [
                    "lodash",
                    "nanoid",
                    "nanoid-dictionary",
                    "qs",
                    "immer"
                ]
            }
        },
        "install": {
            "exclude": [
                "@sentry/react-native",
                "react-native-keyboard-controller"
            ]
        }
    },
    "enriched-markdown": {
        "enableCodeHighlight": true,
        "enableMath": false,
        "codeHighlightLanguages": [
            "json",
            "html",
            "css",
            "markdown",
            "yaml",
            "go",
            "java",
            "javascript",
            "python",
            "c",
            "rust",
            "bash",
            "typescript",
            "tsx",
            "cpp",
            "swift",
            "php",
            "ruby",
            "c-sharp"
        ]
    },
    "dependencies": {
        "@gorhom/bottom-sheet": "^5.2.14",
        "@hookform/resolvers": "^6.0.0",
        "@legendapp/list": "^3.6.0",
        "@pioneer/client-nitro": "workspace:*",
        "@react-native-async-storage/async-storage": "2.2.0",
        "@sentry/react-native": "^8.31.0",
        "@shopify/flash-list": "2.3.2",
        "@tanstack/react-query": "^5.104.5",
        "@workspace-sh/react-native-source-editor": "git+https://github.com/pioneerdotai/react-native-source-editor.git#22a0d1eba1808a4974bd6ba0714ed0c55bf4aff8",
        "dayjs": "^1.11.23",
        "dset": "^3.1.4",
        "expo": "^58.0.16",
        "expo-application": "^58.1.2",
        "expo-asset": "^58.0.17",
        "expo-background-task": "^58.0.11",
        "expo-clipboard": "~58.0.3",
        "expo-constants": "^58.0.12",
        "expo-dev-client": "^58.0.14",
        "expo-device": "^58.0.5",
        "expo-document-picker": "~58.0.4",
        "expo-file-system": "~58.0.10",
        "expo-font": "^58.0.9",
        "expo-haptics": "^58.0.7",
        "expo-image": "~58.0.16",
        "expo-image-picker": "~58.0.10",
        "expo-linking": "^58.0.13",
        "expo-localization": "^58.0.5",
        "expo-navigation-bar": "~58.0.4",
        "expo-network": "^58.0.3",
        "expo-notifications": "^58.1.5",
        "expo-router": "^58.0.24",
        "expo-screen-orientation": "^58.0.3",
        "expo-secure-store": "~58.0.2",
        "expo-splash-screen": "^58.0.10",
        "expo-status-bar": "^58.0.3",
        "expo-store-review": "^58.0.2",
        "expo-system-ui": "^58.0.6",
        "expo-task-manager": "^58.0.12",
        "expo-updates": "^58.0.17",
        "i18next": "^26.5.3",
        "immer": "^11.1.21",
        "intl-pluralrules": "^2.0.1",
        "lodash": "^4.18.1",
        "lucide-react-native": "^1.60.0",
        "nanoid": "^6.0.2",
        "nanoid-dictionary": "^5.0.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-hook-form": "^7.90.0",
        "react-i18next": "^17.1.0",
        "react-native": "0.88.0",
        "react-native-audio-api": "^0.13.6",
        "react-native-drax": "^1.1.0",
        "react-native-enriched-markdown": "1.1.1",
        "react-native-gesture-handler": "~3.3.0",
        "react-native-get-random-values": "~2.0.0",
        "react-native-keyboard-controller": "1.22.8",
        "react-native-mmkv": "^4.3.2",
        "react-native-nitro-modules": "^0.37.1",
        "react-native-otp-entry": "^1.8.6",
        "react-native-permissions": "^5.6.3",
        "react-native-reanimated": "4.7.1",
        "react-native-safe-area-context": "~5.10.1",
        "react-native-screens": "~4.30.0",
        "react-native-streamdown": "0.3.0",
        "react-native-svg": "15.16.0",
        "react-native-unistyles": "^3.5.3",
        "react-native-webview": "14.0.1",
        "react-native-worklets": "0.13.0",
        "remend": "1.4.0",
        "shell-quote": "^1.12.0",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@tanstack/eslint-plugin-query": "^5.104.5",
        "@types/bun": "^1.4.3",
        "@types/fs-extra": "^11.0.4",
        "@types/lodash": "^4.17.26",
        "@types/react": "~19.3.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "babel-preset-expo": "^58.0.18",
        "eslint": "^9.39.5",
        "eslint-config-expo": "^58.0.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-react-compiler": "^19.1.0-rc.2",
        "expo-build-properties": "^58.0.11",
        "fs-extra": "^11.4.1",
        "jest": "~30.5.2",
        "jest-expo": "^58.0.11",
        "json-schema-to-typescript": "^16.0.0",
        "nitrogen": "^0.37.1",
        "prettier": "^3.9.10",
        "react-test-renderer": "^19.3.1",
        "tsx": "^4.23.15",
        "typescript": "~6.0.3"
    },
    "overrides": {
        "zod-validation-error": "^4.0.2"
    },
    "trustedDependencies": [
        "@sentry/cli",
        "@workspace-sh/react-native-source-editor",
        "react-native-enriched-markdown"
    ],
    "patchedDependencies": {
        "metro@0.84.5": "patches/metro@0.84.5.patch",
        "metro-runtime@0.84.5": "patches/metro-runtime@0.84.5.patch",
        "react-native-enriched-markdown@1.0.2": "patches/react-native-enriched-markdown@1.0.2.patch"
    }
}
