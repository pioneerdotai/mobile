{
    "name": "pioneer-app",
    "private": true,
    "workspaces": [
        "modules/pioneer-client-nitro"
    ],
    "main": "index.ts",
    "scripts": {
        "start": "expo start",
        "android": "expo run:android",
        "ios": "expo run:ios",
        "lint": "bunx expo lint",
        "prebuild:ios": "expo prebuild -p ios --clean",
        "prebuild:android": "expo prebuild -p android --clean",
        "build:ios": "eas build --platform ios --profile development --clear-cache",
        "build:android": "eas build --platform android --profile development --clear-cache",
        "release:ios": "eas build --platform ios --profile production --clear-cache --auto-submit",
        "release:android": "eas build --platform android --profile production --clear-cache",
        "eas-build-pre-install": "bash modules/pioneer-client-nitro/scripts/eas-prepare-rust.sh",
        "update:all": "eas update --channel production --environment production --clear-cache && npx sentry-expo-upload-sourcemaps dist",
        "client": "bun run client:schema && bun run client:types",
        "client:schema": "tsx ./scripts/export-client-schema.ts",
        "client:types": "tsx ./scripts/generate-client-types.ts",
        "client:check": "tsx ./scripts/check-client-contract.ts",
        "locale": "tsx ./scripts/generate-translations.ts",
        "nitro:generate": "cd modules/pioneer-client-nitro && nitrogen",
        "rust:build:ios": "env PIONEER_CLIENT_RUST_MODE=source bash modules/pioneer-client-nitro/scripts/build-rust-ios.sh",
        "rust:build:android": "env PIONEER_CLIENT_RUST_MODE=source bash modules/pioneer-client-nitro/scripts/build-rust-android.sh",
        "rust:build:prebuilt": "bun run rust:build:ios && bun run rust:build:android",
        "rust:check:ios": "bash modules/pioneer-client-nitro/scripts/check-rust-prebuilt.sh ios",
        "rust:check:android": "bash modules/pioneer-client-nitro/scripts/check-rust-prebuilt.sh android",
        "rust:check:prebuilt": "bash modules/pioneer-client-nitro/scripts/check-rust-prebuilt.sh all"
    },
    "jest": {
        "preset": "jest-expo",
        "roots": [
            "<rootDir>/src"
        ],
        "transformIgnorePatterns": [
            "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|nanoid|react-native-otp-entry))",
            "/node_modules/react-native-reanimated/plugin/",
            "/node_modules/@react-native/babel-preset/"
        ],
        "moduleNameMapper": {
            "^@/(.*)$": "<rootDir>/src/$1"
        }
    },
    "expo": {
        "doctor": {
            "reactNativeDirectoryCheck": {
                "exclude": [
                    "lodash",
                    "nanoid",
                    "nanoid-dictionary",
                    "qs",
                    "immer"
                ]
            }
        },
        "install": {
            "exclude": [
                "@sentry/react-native",
                "react-native-keyboard-controller"
            ]
        }
    },
    "enriched-markdown": {
        "enableCodeHighlight": true,
        "enableMath": false,
        "codeHighlightLanguages": [
            "json",
            "html",
            "css",
            "markdown",
            "yaml",
            "go",
            "java",
            "javascript",
            "python",
            "c",
            "rust",
            "bash",
            "typescript",
            "tsx",
            "cpp",
            "swift",
            "php",
            "ruby",
            "c-sharp"
        ]
    },
    "dependencies": {
        "@gorhom/bottom-sheet": "^5.2.14",
        "@hookform/resolvers": "^5.9.1",
        "@legendapp/list": "^3.3.8",
        "@pioneer/client-nitro": "workspace:*",
        "@react-native-async-storage/async-storage": "2.2.0",
        "@sentry/react-native": "^8.23.0",
        "@shopify/flash-list": "2.0.2",
        "@tanstack/react-query": "^5.102.2",
        "dayjs": "^1.11.23",
        "dset": "^3.1.4",
        "expo": "^57.0.16",
        "expo-application": "^57.0.2",
        "expo-asset": "^57.0.14",
        "expo-background-task": "^57.0.13",
        "expo-clipboard": "~57.0.1",
        "expo-constants": "^57.0.14",
        "expo-dev-client": "^57.0.15",
        "expo-device": "^57.0.1",
        "expo-document-picker": "~57.0.1",
        "expo-file-system": "~57.0.5",
        "expo-font": "^57.0.1",
        "expo-haptics": "^57.0.1",
        "expo-image": "~57.0.3",
        "expo-image-picker": "~57.0.13",
        "expo-linking": "^57.0.7",
        "expo-localization": "^57.0.1",
        "expo-network": "^57.0.1",
        "expo-notifications": "^57.0.14",
        "expo-router": "^57.0.16",
        "expo-screen-orientation": "^57.0.1",
        "expo-secure-store": "~57.0.1",
        "expo-splash-screen": "^57.0.8",
        "expo-status-bar": "^57.0.1",
        "expo-store-review": "^57.0.2",
        "expo-system-ui": "^57.0.2",
        "expo-task-manager": "^57.0.13",
        "expo-updates": "^57.0.17",
        "i18next": "^26.4.0",
        "immer": "^11.1.18",
        "intl-pluralrules": "^2.0.1",
        "lodash": "^4.18.1",
        "lucide-react-native": "^1.33.0",
        "nanoid": "^6.0.1",
        "nanoid-dictionary": "^5.0.0",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-hook-form": "^7.86.0",
        "react-i18next": "^17.0.12",
        "react-native": "0.86.2",
        "react-native-audio-api": "^0.13.3",
        "react-native-drax": "^1.1.0",
        "react-native-edge-to-edge": "^1.8.1",
        "react-native-enriched-markdown": "1.0.2",
        "react-native-gesture-handler": "~2.32.0",
        "react-native-get-random-values": "~1.11.0",
        "react-native-keyboard-controller": "1.22.4",
        "react-native-mmkv": "^4.3.2",
        "react-native-nitro-modules": "^0.37.0",
        "react-native-otp-entry": "^1.8.6",
        "react-native-permissions": "^5.6.1",
        "react-native-reanimated": "4.5.1",
        "react-native-safe-area-context": "~5.7.0",
        "react-native-screens": "~4.26.0",
        "react-native-streamdown": "0.2.0",
        "react-native-svg": "15.15.4",
        "react-native-unistyles": "^3.3.0",
        "react-native-worklets": "0.10.1",
        "remend": "1.3.0",
        "shell-quote": "^1.10.0",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@babel/core": "^7.29.0",
        "@tanstack/eslint-plugin-query": "^5.102.2",
        "@types/bun": "^1.4.0",
        "@types/fs-extra": "^11.0.4",
        "@types/lodash": "^4.17.25",
        "@types/react": "^19.2.18",
        "babel-plugin-react-compiler": "^1.0.0",
        "babel-preset-expo": "^57.0.8",
        "eslint": "^9.39.5",
        "eslint-config-expo": "^57.0.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react-compiler": "^19.1.0-rc.2",
        "expo-build-properties": "^57.0.14",
        "fs-extra": "^11.4.0",
        "jest": "~29.7.0",
        "jest-expo": "^57.0.4",
        "json-schema-to-typescript": "^15.0.4",
        "nitrogen": "^0.37.0",
        "prettier": "^3.9.6",
        "react-test-renderer": "^19.2.8",
        "tsx": "^4.23.12",
        "typescript": "~6.0.3"
    },
    "overrides": {
        "zod-validation-error": "^4.0.2"
    },
    "trustedDependencies": [
        "@sentry/cli",
        "react-native-enriched-markdown"
    ],
    "patchedDependencies": {
        "metro@0.84.5": "patches/metro@0.84.5.patch",
        "metro-runtime@0.84.5": "patches/metro-runtime@0.84.5.patch"
    }
}
