{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClientChangeBatchDto",
  "type": "object",
  "properties": {
    "changes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ClientChangeDto"
      }
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "changes"
  ],
  "$defs": {
    "ClientChangeDto": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "publication"
            },
            "predecessor": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            },
            "sequence": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "snapshot": {
              "$ref": "#/$defs/ClientScopedSnapshotDto"
            }
          },
          "required": [
            "kind",
            "sequence",
            "snapshot"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "resnapshot_required"
            },
            "latest_sequence": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "scope": {
              "$ref": "#/$defs/ClientScope"
            }
          },
          "required": [
            "kind",
            "scope",
            "latest_sequence"
          ]
        }
      ]
    },
    "ClientRevisions": {
      "type": "object",
      "properties": {
        "content": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "domain": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "presentation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "scoped": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "domain",
        "presentation",
        "content",
        "scoped"
      ]
    },
    "ClientScope": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "session"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "navigation"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "sidebar_summary"
            },
            "thread_id": {
              "type": "string"
            },
            "workspace_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "workspace_id",
            "thread_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "workspace_tree"
            },
            "workspace_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "task_inbox"
            },
            "workspace_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "workspace_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "task"
            },
            "task_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "thread"
            },
            "thread_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "thread_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "timeline"
            },
            "thread_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "thread_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "composer"
            },
            "thread_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "thread_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "pending_request"
            },
            "thread_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "workspace_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "artifact"
            },
            "thread_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "thread_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "avatar"
            },
            "principal_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "principal_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "provider"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "administration"
            },
            "workspace_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "mcp"
            },
            "workspace_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "skills"
            },
            "workspace_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "settings"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "onboarding_invitation"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "agents_document"
            },
            "workspace_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "workspace_id"
          ]
        }
      ]
    },
    "ClientScopedSnapshotDto": {
      "type": "object",
      "properties": {
        "payload": true,
        "revisions": {
          "$ref": "#/$defs/ClientRevisions"
        },
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "scope": {
          "$ref": "#/$defs/ClientScope"
        },
        "sequence": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "schema_version",
        "sequence",
        "scope",
        "revisions",
        "payload"
      ]
    }
  }
}