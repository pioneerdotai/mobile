{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CLIRuntimeThreadBinding",
  "type": "object",
  "properties": {
    "runtime_id": {
      "type": "string"
    },
    "runtime_kind": {
      "$ref": "#/$defs/CLIAgentRuntimeKind"
    },
    "status": {
      "type": "string"
    },
    "thread_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "thread_id",
    "runtime_id",
    "runtime_kind",
    "status"
  ],
  "$defs": {
    "CLIAgentRuntimeKind": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "codex",
            "claude"
          ]
        },
        {
          "description": "The standard ACP transport, shared by every configured ACP instance.",
          "type": "string",
          "const": "acp"
        }
      ]
    }
  }
}