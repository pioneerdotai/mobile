{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClientActiveThreadSendTextRequest",
  "type": "object",
  "properties": {
    "expanded_keys": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "operation": {
      "$ref": "#/$defs/ComposerOperationIdentity"
    },
    "workspace_id": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    }
  },
  "additionalProperties": false,
  "required": [
    "operation"
  ],
  "$defs": {
    "ComposerOperationIdentity": {
      "type": "object",
      "properties": {
        "draft_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "generation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "thread_id": {
          "type": "string"
        }
      },
      "required": [
        "thread_id",
        "draft_id",
        "generation"
      ]
    }
  }
}