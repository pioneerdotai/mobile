{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClientInvitationListRowRequest",
  "type": "object",
  "properties": {
    "auth": {
      "$ref": "#/$defs/AuthMeResponse"
    },
    "invitation": {
      "$ref": "#/$defs/InvitationSummary"
    }
  },
  "additionalProperties": false,
  "required": [
    "auth",
    "invitation"
  ],
  "$defs": {
    "AuthDeviceSnapshot": {
      "type": "object",
      "properties": {
        "client_kind": {
          "$ref": "#/$defs/ClientKind"
        },
        "display_name": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/DeviceId"
        },
        "installation_id": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/DeviceStatus"
        }
      },
      "required": [
        "id",
        "installation_id",
        "display_name",
        "client_kind",
        "status"
      ]
    },
    "AuthGatewaySnapshot": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/GatewayId"
        }
      },
      "required": [
        "id"
      ]
    },
    "AuthMeResponse": {
      "type": "object",
      "properties": {
        "device": {
          "$ref": "#/$defs/AuthDeviceSnapshot"
        },
        "gateway": {
          "$ref": "#/$defs/AuthGatewaySnapshot"
        },
        "principal": {
          "$ref": "#/$defs/AuthPrincipalSnapshot"
        },
        "role_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/RoleKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "session": {
          "$ref": "#/$defs/AuthSessionSnapshot"
        }
      },
      "required": [
        "gateway",
        "principal",
        "device",
        "session"
      ]
    },
    "AuthPrincipalSnapshot": {
      "type": "object",
      "properties": {
        "avatar_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "display_name": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/PrincipalId"
        },
        "kind": {
          "$ref": "#/$defs/PrincipalKind"
        },
        "nickname": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "display_name",
        "nickname"
      ]
    },
    "AuthSessionId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "AuthSessionSnapshot": {
      "type": "object",
      "properties": {
        "device_id": {
          "$ref": "#/$defs/DeviceId"
        },
        "id": {
          "$ref": "#/$defs/AuthSessionId"
        },
        "refresh_expires_at_unix": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "refresh_generation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/AuthSessionStatus"
        },
        "token_family_id": {
          "$ref": "#/$defs/TokenFamilyId"
        }
      },
      "required": [
        "id",
        "device_id",
        "token_family_id",
        "status",
        "refresh_generation",
        "refresh_expires_at_unix"
      ]
    },
    "AuthSessionStatus": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "revoked",
        "expired"
      ]
    },
    "ClientKind": {
      "type": "string",
      "enum": [
        "desktop",
        "mobile",
        "other"
      ]
    },
    "DeviceId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "DeviceStatus": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "revoked"
      ]
    },
    "GatewayId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "InvitationId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "InvitationInviterSummary": {
      "type": "object",
      "properties": {
        "display_name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/PrincipalKind"
        },
        "nickname": {
          "type": "string"
        },
        "principal_id": {
          "$ref": "#/$defs/PrincipalId"
        }
      },
      "required": [
        "principal_id",
        "kind",
        "display_name",
        "nickname"
      ]
    },
    "InvitationRevokeReason": {
      "type": "string",
      "enum": [
        "inviter_revoked",
        "inviter_unavailable",
        "grant_authority_lost",
        "workspace_unavailable"
      ]
    },
    "InvitationStatus": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "revoked",
        "expired"
      ]
    },
    "InvitationSummary": {
      "type": "object",
      "properties": {
        "created_at_unix": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "expires_at_unix": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "invitation_id": {
          "$ref": "#/$defs/InvitationId"
        },
        "inviter": {
          "$ref": "#/$defs/InvitationInviterSummary"
        },
        "revoke_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/InvitationRevokeReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/InvitationStatus"
        },
        "terminal_at_unix": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "workspaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InvitationWorkspaceSummary"
          }
        }
      },
      "required": [
        "invitation_id",
        "status",
        "inviter",
        "workspaces",
        "created_at_unix",
        "expires_at_unix"
      ]
    },
    "InvitationWorkspaceSummary": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "workspace_id",
        "name"
      ]
    },
    "PrincipalId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "PrincipalKind": {
      "type": "string",
      "enum": [
        "superuser",
        "user"
      ]
    },
    "RoleKey": {
      "type": "string",
      "maxLength": 32,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "TokenFamilyId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "WorkspaceId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    }
  }
}