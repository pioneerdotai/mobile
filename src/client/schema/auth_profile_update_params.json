{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuthProfileUpdateParams",
  "type": "object",
  "properties": {
    "avatar": {
      "$ref": "#/$defs/AuthProfileAvatarUpdate",
      "default": {
        "action": "unchanged"
      }
    },
    "display_name": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1
    },
    "nickname": {
      "type": "string",
      "maxLength": 32,
      "minLength": 2,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{1,31}$"
    }
  },
  "additionalProperties": false,
  "required": [
    "display_name",
    "nickname"
  ],
  "$defs": {
    "AuthProfileAvatarUpdate": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "unchanged"
            }
          },
          "required": [
            "action"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "remove"
            }
          },
          "required": [
            "action"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "set"
            },
            "avatar": {
              "$ref": "#/$defs/ProfileAvatarInput"
            }
          },
          "required": [
            "action",
            "avatar"
          ]
        }
      ]
    },
    "ProfileAvatarInput": {
      "type": "object",
      "properties": {
        "content_base64": {
          "type": "string",
          "maxLength": 349528,
          "minLength": 1
        },
        "media_type": {
          "$ref": "#/$defs/ProfileAvatarMediaType"
        }
      },
      "additionalProperties": false,
      "required": [
        "media_type",
        "content_base64"
      ]
    },
    "ProfileAvatarMediaType": {
      "type": "string",
      "enum": [
        "image/png",
        "image/jpeg",
        "image/webp"
      ]
    }
  }
}