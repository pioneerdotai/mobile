{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuthSessionRevokeResponse",
  "type": "object",
  "properties": {
    "revoked": {
      "type": "boolean"
    },
    "session_id": {
      "$ref": "#/$defs/AuthSessionId"
    }
  },
  "required": [
    "session_id",
    "revoked"
  ],
  "$defs": {
    "AuthSessionId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    }
  }
}