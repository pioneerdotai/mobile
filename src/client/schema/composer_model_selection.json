{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ComposerModelSelection",
  "type": "object",
  "properties": {
    "model": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "selected_context_authority": {
      "type": [
        "string",
        "null"
      ]
    },
    "selected_context_window": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "selected_reasoning_effort": {
      "type": [
        "string",
        "null"
      ]
    },
    "selected_service_mode": {
      "anyOf": [
        {
          "$ref": "#/$defs/NativeServiceModeSelection"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "provider",
    "model"
  ],
  "$defs": {
    "NativeServiceModeSelection": {
      "description": "Explicit choice uses the existing endpoint/credential/model authority proof.\nAbsence means Standard; Inherit belongs to the enclosing model selection.",
      "type": "object",
      "properties": {
        "authority": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "authority"
      ]
    }
  }
}