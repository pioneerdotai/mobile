{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClientIntent",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "expected_revision": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "intent": {
          "$ref": "#/$defs/NavigationIntent"
        },
        "kind": {
          "type": "string",
          "const": "navigation"
        }
      },
      "required": [
        "kind",
        "intent"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "refresh_timeline"
        },
        "thread_id": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "thread_id"
      ]
    },
    {
      "type": "object",
      "properties": {
        "collapsed_row_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kind": {
          "type": "string",
          "const": "set_timeline_expansion"
        },
        "row_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "thread_id": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "thread_id",
        "row_ids",
        "collapsed_row_ids"
      ]
    },
    {
      "type": "object",
      "properties": {
        "after": {
          "type": "boolean"
        },
        "before": {
          "type": "boolean"
        },
        "kind": {
          "type": "string",
          "const": "timeline_viewport"
        },
        "presented_rows": {
          "type": "boolean"
        },
        "row_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "thread_id": {
          "type": "string"
        },
        "threshold": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "work": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "thread_id",
        "row_ids",
        "source_revision",
        "threshold",
        "before",
        "after",
        "work",
        "presented_rows"
      ]
    },
    {
      "type": "object",
      "properties": {
        "demand": {
          "$ref": "#/$defs/ClientDemand"
        },
        "generation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "kind": {
          "type": "string",
          "const": "set_scope_demand"
        },
        "scope": {
          "$ref": "#/$defs/ClientScope"
        }
      },
      "required": [
        "kind",
        "scope",
        "demand",
        "generation"
      ]
    }
  ],
  "$defs": {
    "AdministrationRoute": {
      "type": "string",
      "enum": [
        "Members",
        "Invitations"
      ]
    },
    "ClientDemand": {
      "type": "string",
      "enum": [
        "suspended",
        "visible",
        "prefetch"
      ]
    },
    "ClientScope": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "session"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "navigation"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "sidebar_summary"
            },
            "thread_id": {
              "type": "string"
            },
            "workspace_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "workspace_id",
            "thread_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "workspace_tree"
            },
            "workspace_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "task"
            },
            "task_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "thread"
            },
            "thread_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "thread_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "timeline"
            },
            "thread_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "thread_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "composer"
            },
            "thread_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "thread_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "pending_request"
            },
            "thread_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "workspace_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "artifact"
            },
            "thread_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "thread_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "avatar"
            },
            "principal_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "principal_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "provider"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "administration"
            },
            "workspace_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "mcp"
            },
            "workspace_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "skills"
            },
            "workspace_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "settings"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "onboarding_invitation"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "agents_document"
            },
            "workspace_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "workspace_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "desktop_update"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "NavigationIntent": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "set_administration_route"
            },
            "route": {
              "$ref": "#/$defs/AdministrationRoute"
            }
          },
          "required": [
            "kind",
            "route"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "set_settings_route"
            },
            "route": {
              "$ref": "#/$defs/SettingsRoute"
            }
          },
          "required": [
            "kind",
            "route"
          ]
        },
        {
          "type": "object",
          "properties": {
            "filter": {
              "$ref": "#/$defs/ProviderFilter"
            },
            "kind": {
              "type": "string",
              "const": "set_providers_route"
            }
          },
          "required": [
            "kind",
            "filter"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "set_mcp_route"
            },
            "server_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "set_skills_route"
            },
            "skill_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SkillId"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "select_workspace"
            },
            "workspace_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "select_thread"
            },
            "thread_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "workspace_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "destination": {
              "$ref": "#/$defs/SemanticDestination"
            },
            "kind": {
              "type": "string",
              "const": "navigate"
            }
          },
          "required": [
            "kind",
            "destination"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "remember_draft"
            },
            "thread_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "workspace_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "workspace_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "remember_last"
            },
            "thread_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "workspace_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "workspace_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "promote_thread"
            },
            "thread_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "thread_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "entry": {
              "$ref": "#/$defs/TaskThreadLineage"
            },
            "kind": {
              "type": "string",
              "const": "push_task_thread"
            }
          },
          "required": [
            "kind",
            "entry"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "pop_task_thread"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "clear_lineage"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "reset"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "ProviderFilter": {
      "type": "string",
      "enum": [
        "Api",
        "Connected",
        "Cli"
      ]
    },
    "SemanticDestination": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "threads"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "agents_document"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "filter": {
              "$ref": "#/$defs/ProviderFilter"
            },
            "kind": {
              "type": "string",
              "const": "providers"
            }
          },
          "required": [
            "kind",
            "filter"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "administration"
            },
            "route": {
              "$ref": "#/$defs/AdministrationRoute"
            }
          },
          "required": [
            "kind",
            "route"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "mcp"
            },
            "server_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "skills"
            },
            "skill_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SkillId"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "settings"
            },
            "route": {
              "$ref": "#/$defs/SettingsRoute"
            }
          },
          "required": [
            "kind",
            "route"
          ]
        }
      ]
    },
    "SettingsRoute": {
      "type": "string",
      "enum": [
        "General",
        "Account",
        "Memory",
        "SelfImprovement"
      ]
    },
    "SkillId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "TaskThreadLineage": {
      "type": "object",
      "properties": {
        "child_thread_id": {
          "type": "string"
        },
        "parent_thread_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "parent_thread_id",
        "child_thread_id",
        "workspace_id",
        "title"
      ]
    }
  }
}