{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClientIntentDispatchDto",
  "type": "object",
  "properties": {
    "intent": {
      "$ref": "#/$defs/ClientIntent"
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intent"
  ],
  "$defs": {
    "ClientDemand": {
      "type": "string",
      "enum": [
        "suspended",
        "visible",
        "prefetch"
      ]
    },
    "ClientIntent": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "refresh_timeline"
            },
            "thread_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "thread_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "collapsed_row_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "kind": {
              "type": "string",
              "const": "set_timeline_expansion"
            },
            "row_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "thread_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "thread_id",
            "row_ids",
            "collapsed_row_ids"
          ]
        },
        {
          "type": "object",
          "properties": {
            "after": {
              "type": "boolean"
            },
            "before": {
              "type": "boolean"
            },
            "kind": {
              "type": "string",
              "const": "timeline_viewport"
            },
            "presented_rows": {
              "type": "boolean"
            },
            "row_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "source_revision": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "thread_id": {
              "type": "string"
            },
            "threshold": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "work": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "thread_id",
            "row_ids",
            "source_revision",
            "threshold",
            "before",
            "after",
            "work",
            "presented_rows"
          ]
        },
        {
          "type": "object",
          "properties": {
            "demand": {
              "$ref": "#/$defs/ClientDemand"
            },
            "generation": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "set_scope_demand"
            },
            "scope": {
              "$ref": "#/$defs/ClientScope"
            }
          },
          "required": [
            "kind",
            "scope",
            "demand",
            "generation"
          ]
        }
      ]
    },
    "ClientScope": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "session"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "navigation"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "sidebar_summary"
            },
            "thread_id": {
              "type": "string"
            },
            "workspace_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "workspace_id",
            "thread_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "workspace_tree"
            },
            "workspace_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "task"
            },
            "task_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "thread"
            },
            "thread_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "thread_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "timeline"
            },
            "thread_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "thread_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "composer"
            },
            "thread_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "thread_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "pending_request"
            },
            "thread_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "workspace_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "artifact"
            },
            "thread_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "thread_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "avatar"
            },
            "principal_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "principal_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "provider"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "administration"
            },
            "workspace_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "mcp"
            },
            "workspace_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "skills"
            },
            "workspace_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "settings"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "onboarding_invitation"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "agents_document"
            },
            "workspace_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "workspace_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "desktop_update"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    }
  }
}