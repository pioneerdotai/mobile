{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClientEffectCompletion",
  "type": "object",
  "properties": {
    "generation": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "operation_id": {
      "type": "string"
    },
    "result": {
      "$ref": "#/$defs/ClientEffectResult"
    }
  },
  "required": [
    "operation_id",
    "generation",
    "result"
  ],
  "$defs": {
    "ClientEffectResult": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "completed"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "failed"
            }
          },
          "required": [
            "kind",
            "code"
          ]
        }
      ]
    }
  }
}