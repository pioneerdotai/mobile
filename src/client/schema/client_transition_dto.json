{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClientTransitionDto",
  "type": "object",
  "properties": {
    "composer_begin_plan": {
      "description": "Command receipt from Begin's own immutable publication, independent of delivery.",
      "anyOf": [
        {
          "$ref": "#/$defs/ComposerOperationPlan"
        },
        {
          "type": "null"
        }
      ]
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ClientEffectPlan"
      }
    },
    "outcome": {
      "$ref": "#/$defs/ClientTransitionOutcome"
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "sequence": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "sequence",
    "outcome",
    "effects"
  ],
  "$defs": {
    "AdministrationPresentationEffect": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "copy_administration_activation"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "AuthSessionId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "ClientEffect": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "RefreshWorkspaceList",
            "RefreshGatewaySettings",
            "RefreshProviderLists",
            "QueueSkillsRefresh",
            "EnqueueInFlightTurnsForResume"
          ]
        },
        {
          "type": "object",
          "properties": {
            "UnsubscribeThreads": {
              "type": "object",
              "properties": {
                "thread_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "thread_ids"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "UnsubscribeThreads"
          ]
        }
      ]
    },
    "ClientEffectPlan": {
      "type": "object",
      "properties": {
        "effect": {
          "$ref": "#/$defs/ClientPlannedEffect"
        },
        "generation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "operation_id": {
          "type": "string"
        }
      },
      "required": [
        "operation_id",
        "generation",
        "effect"
      ]
    },
    "ClientPlannedEffect": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClientEffect"
        },
        {
          "$ref": "#/$defs/AdministrationPresentationEffect"
        },
        {
          "$ref": "#/$defs/ProviderPresentationEffect"
        },
        {
          "$ref": "#/$defs/GatewaySessionStorageEffect"
        },
        {
          "$ref": "#/$defs/OnboardingPlatformEffect"
        }
      ]
    },
    "ClientTransitionOutcome": {
      "type": "string",
      "enum": [
        "changed",
        "noop",
        "stale",
        "rejected"
      ]
    },
    "DeviceId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "GatewayEndpoint": {
      "type": "object",
      "properties": {
        "gateway_base_url": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/GatewayEndpointKind"
        },
        "name": {
          "type": "string"
        },
        "server_gateway_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/GatewayId"
            },
            {
              "type": "null"
            }
          ]
        },
        "service_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "workspace_id": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "gateway_base_url",
        "kind"
      ]
    },
    "GatewayEndpointKind": {
      "type": "string",
      "enum": [
        "local",
        "remote"
      ]
    },
    "GatewayId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "GatewayRegistry": {
      "type": "object",
      "properties": {
        "active_gateway_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "installation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "local": {
          "anyOf": [
            {
              "$ref": "#/$defs/GatewayEndpoint"
            },
            {
              "type": "null"
            }
          ]
        },
        "remotes": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/GatewayEndpoint"
          }
        },
        "version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "version"
      ]
    },
    "GatewaySessionEnvelope": {
      "type": "object",
      "properties": {
        "device_id": {
          "$ref": "#/$defs/DeviceId"
        },
        "gateway_id": {
          "$ref": "#/$defs/GatewayId"
        },
        "installation_id": {
          "type": "string"
        },
        "pending_refresh_request_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "principal_id": {
          "$ref": "#/$defs/PrincipalId"
        },
        "refresh_expires_at_unix": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "refresh_generation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "refresh_token": {
          "type": "string"
        },
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "session_id": {
          "$ref": "#/$defs/AuthSessionId"
        },
        "token_family_id": {
          "$ref": "#/$defs/TokenFamilyId"
        }
      },
      "additionalProperties": false,
      "required": [
        "schema_version",
        "gateway_id",
        "principal_id",
        "device_id",
        "session_id",
        "token_family_id",
        "installation_id",
        "refresh_generation",
        "refresh_expires_at_unix",
        "refresh_token"
      ]
    },
    "GatewaySessionStorageEffect": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "DeleteGatewaySession": {
              "type": "object",
              "properties": {
                "endpoint": {
                  "$ref": "#/$defs/GatewayEndpoint"
                }
              },
              "required": [
                "endpoint"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "DeleteGatewaySession"
          ]
        },
        {
          "type": "object",
          "properties": {
            "ReadGatewaySession": {
              "type": "object",
              "properties": {
                "endpoint": {
                  "$ref": "#/$defs/GatewayEndpoint"
                }
              },
              "required": [
                "endpoint"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "ReadGatewaySession"
          ]
        },
        {
          "type": "object",
          "properties": {
            "PersistGatewaySession": {
              "type": "object",
              "properties": {
                "endpoint": {
                  "$ref": "#/$defs/GatewayEndpoint"
                },
                "envelope": {
                  "$ref": "#/$defs/GatewaySessionEnvelope"
                }
              },
              "required": [
                "endpoint",
                "envelope"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "PersistGatewaySession"
          ]
        }
      ]
    },
    "OnboardingPlatformEffect": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "LoadGatewayEnvironment"
          ]
        },
        {
          "type": "object",
          "properties": {
            "RemoveGatewayBindingJournal": {
              "type": "object",
              "properties": {
                "gateway_id": {
                  "type": "string"
                }
              },
              "required": [
                "gateway_id"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "RemoveGatewayBindingJournal"
          ]
        },
        {
          "type": "object",
          "properties": {
            "PersistGatewayRegistry": {
              "type": "object",
              "properties": {
                "registry": {
                  "$ref": "#/$defs/GatewayRegistry"
                }
              },
              "required": [
                "registry"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "PersistGatewayRegistry"
          ]
        },
        {
          "type": "object",
          "properties": {
            "PrepareLocalGateway": {
              "type": "object",
              "properties": {
                "endpoint": {
                  "$ref": "#/$defs/GatewayEndpoint"
                },
                "recover": {
                  "type": "boolean"
                }
              },
              "required": [
                "endpoint",
                "recover"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "PrepareLocalGateway"
          ]
        },
        {
          "type": "object",
          "properties": {
            "CreateLocalDeviceActivation": {
              "type": "object",
              "properties": {
                "endpoint_id": {
                  "type": "string"
                }
              },
              "required": [
                "endpoint_id"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "CreateLocalDeviceActivation"
          ]
        }
      ]
    },
    "PrincipalId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "ProviderPresentationEffect": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "copy_provider_diagnostics"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "open_provider_path"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path"
          ]
        }
      ]
    },
    "TokenFamilyId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "AgentExecutionId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "AgentIdentityId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "AgentIdentitySourceKind": {
      "type": "string",
      "enum": [
        "native_agent",
        "cli_runtime_instance",
        "ephemeral"
      ]
    },
    "AgentPresentationSnapshot": {
      "type": "object",
      "properties": {
        "agent_execution_id": {
          "$ref": "#/$defs/AgentExecutionId"
        },
        "agent_identity_id": {
          "$ref": "#/$defs/AgentIdentityId"
        },
        "avatar_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "display_name": {
          "type": "string"
        },
        "identity_source_kind": {
          "$ref": "#/$defs/AgentIdentitySourceKind"
        },
        "identity_source_revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "nickname": {
          "type": "string"
        },
        "role_label": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "agent_identity_id",
        "agent_execution_id",
        "identity_source_kind",
        "identity_source_revision",
        "display_name",
        "nickname"
      ]
    },
    "AgentResultReturnPolicy": {
      "type": "string",
      "enum": [
        "none",
        "summary_only",
        "full_result"
      ]
    },
    "AgentRouteAction": {
      "type": "string",
      "enum": [
        "send_message",
        "start_agent",
        "create_task",
        "schedule_task",
        "review_task_result",
        "deliver_result"
      ]
    },
    "AgentRouteDisclosurePolicy": {
      "type": "object",
      "properties": {
        "artifacts": {
          "description": "Exact, already-authorized artifact handles. Raw files and paths are\nnever represented by this flag.",
          "type": "boolean",
          "default": false
        },
        "context": {
          "description": "Bounded conversation excerpts or summaries selected by server policy.",
          "type": "boolean",
          "default": false
        },
        "resultReturn": {
          "description": "Result return is a separate disclosure class: allowing ordinary text\nmust never imply that a full Task result can cross a capsule boundary.",
          "$ref": "#/$defs/AgentResultReturnPolicy",
          "default": "none"
        },
        "text": {
          "description": "Explicit text authored for the routed operation.",
          "type": "boolean",
          "default": false
        },
        "userInput": {
          "description": "Explicit user-provided Task inputs. This is deliberately independent\nfrom Agent-authored text and inherited conversation context.",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "ArtifactKind": {
      "type": "string",
      "enum": [
        "file",
        "text",
        "image",
        "audio",
        "video",
        "pdf",
        "spreadsheet",
        "archive",
        "json",
        "generated_image",
        "screenshot",
        "workspace_file",
        "directory_manifest",
        "unknown"
      ]
    },
    "ArtifactPreviewRef": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "blob_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "mime_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "projection_kind": {
          "$ref": "#/$defs/ArtifactProjectionKind"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/ArtifactProjectionStatus"
        },
        "version_id": {
          "type": "string"
        }
      },
      "required": [
        "projection_kind",
        "status",
        "artifact_id",
        "version_id"
      ]
    },
    "ArtifactProjectionKind": {
      "type": "string",
      "enum": [
        "plain_text",
        "thumbnail",
        "json_summary",
        "pdf_text"
      ]
    },
    "ArtifactProjectionStatus": {
      "type": "string",
      "enum": [
        "pending",
        "ready",
        "failed",
        "stale"
      ]
    },
    "ArtifactRef": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "mime_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "preview": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactPreviewRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/ArtifactStatus"
        },
        "version_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "artifact_id",
        "display_name",
        "kind",
        "status"
      ]
    },
    "ArtifactStatus": {
      "type": "string",
      "enum": [
        "ready",
        "pending",
        "quarantined",
        "deleted",
        "missing_external_source",
        "failed"
      ]
    },
    "CLIAgentRuntimeKind": {
      "type": "string",
      "enum": [
        "codex",
        "claude",
        "opencode"
      ]
    },
    "ComposerAttachment": {
      "type": "object",
      "properties": {
        "file_name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ComposerAttachmentKind"
        },
        "path": {
          "type": "string"
        },
        "upload_state": {
          "$ref": "#/$defs/ComposerAttachmentUploadState"
        }
      },
      "required": [
        "path",
        "file_name",
        "kind",
        "upload_state"
      ]
    },
    "ComposerAttachmentKind": {
      "type": "string",
      "enum": [
        "Image",
        "File",
        "Audio",
        "Video"
      ]
    },
    "ComposerAttachmentUploadState": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Local",
            "Uploading"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Uploaded": {
              "type": "object",
              "properties": {
                "artifact": {
                  "$ref": "#/$defs/ArtifactRef"
                }
              },
              "required": [
                "artifact"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Uploaded"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Failed": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string"
                }
              },
              "required": [
                "error"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Failed"
          ]
        }
      ]
    },
    "ComposerCapability": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ComposerCapabilityKind"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "kind"
      ]
    },
    "ComposerCapabilityKind": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "Skill": {
              "type": "object",
              "properties": {
                "owner": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "skill_id": {
                  "$ref": "#/$defs/SkillId"
                },
                "slug": {
                  "type": "string"
                },
                "source_kind": {
                  "type": "string"
                }
              },
              "required": [
                "skill_id",
                "slug",
                "source_kind"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Skill"
          ]
        },
        {
          "type": "object",
          "properties": {
            "McpServer": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "scope_kind": {
                  "$ref": "#/$defs/McpScopeKind"
                }
              },
              "required": [
                "name",
                "scope_kind"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "McpServer"
          ]
        },
        {
          "type": "object",
          "properties": {
            "McpTool": {
              "type": "object",
              "properties": {
                "raw_tool_name": {
                  "type": "string"
                },
                "scope_kind": {
                  "$ref": "#/$defs/McpScopeKind"
                },
                "server_name": {
                  "type": "string"
                }
              },
              "required": [
                "server_name",
                "raw_tool_name",
                "scope_kind"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "McpTool"
          ]
        }
      ]
    },
    "ComposerCapabilityTarget": {
      "description": "Capability eligibility context.\n\nThe target kind exists only because native skills retain their current\nsource policy while CLI skills must be exportable. Capability support is\nrepresented exclusively by [`ComposerCapabilityPolicy`].",
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ComposerCapabilityTargetKind"
        },
        "supports_mcp_tools": {
          "type": "boolean"
        },
        "supports_skills": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "supports_skills",
        "supports_mcp_tools"
      ]
    },
    "ComposerCapabilityTargetKind": {
      "type": "string",
      "enum": [
        "native",
        "cli"
      ]
    },
    "ComposerDomainDraft": {
      "description": "Complete, shell-neutral draft payload used by desktop and mobile.\n\nHot editor state (cursor, IME composition, focus, keyboard, sheets) is not\npart of this value. Client owns the text; shells publish user edits and\napply controlled publications without moving cursor or IME state into Client.",
      "type": "object",
      "properties": {
        "domain": {
          "$ref": "#/$defs/ComposerDomainState"
        },
        "text": {
          "type": "string",
          "default": ""
        }
      },
      "additionalProperties": false,
      "required": [
        "domain"
      ]
    },
    "ComposerDomainState": {
      "type": "object",
      "properties": {
        "attachments": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ComposerAttachment"
          }
        },
        "capabilities": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ComposerCapability"
          }
        },
        "capability_target": {
          "$ref": "#/$defs/ComposerCapabilityTarget"
        },
        "mode_manually_selected": {
          "type": "boolean",
          "default": false
        },
        "model_manually_selected": {
          "type": "boolean",
          "default": false
        },
        "reply_target": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComposerReplyTarget"
            },
            {
              "type": "null"
            }
          ]
        },
        "selected_mentions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComposerMentionSelection"
          }
        },
        "selected_mode": {
          "$ref": "#/$defs/ThreadMode",
          "default": "Message"
        },
