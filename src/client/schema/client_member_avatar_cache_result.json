{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClientMemberAvatarCacheResult",
  "type": "object",
  "properties": {
    "avatar_revision": {
      "type": "string"
    },
    "cached_image_path": {
      "type": "string"
    },
    "media_type": {
      "$ref": "#/$defs/ProfileAvatarMediaType"
    },
    "principal_id": {
      "$ref": "#/$defs/PrincipalId"
    },
    "source": {
      "$ref": "#/$defs/AvatarCacheSource"
    }
  },
  "required": [
    "cached_image_path",
    "principal_id",
    "avatar_revision",
    "media_type",
    "source"
  ],
  "$defs": {
    "AvatarCacheSource": {
      "type": "string",
      "enum": [
        "downloaded",
        "revalidated",
        "offline_cache"
      ]
    },
    "PrincipalId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "ProfileAvatarMediaType": {
      "type": "string",
      "enum": [
        "image/png",
        "image/jpeg",
        "image/webp"
      ]
    }
  }
}