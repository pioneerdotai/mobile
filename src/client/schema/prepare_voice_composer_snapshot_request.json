{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrepareVoiceComposerSnapshotRequest",
  "type": "object",
  "properties": {
    "attachments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ComposerAttachment"
      }
    },
    "authorization_fingerprint": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ComposerCapability"
      }
    },
    "cli_runtime_options": {
      "anyOf": [
        {
          "$ref": "#/$defs/TurnCLIRuntimeOptions"
        },
        {
          "type": "null"
        }
      ]
    },
    "endpoint_kind": {
      "anyOf": [
        {
          "$ref": "#/$defs/GatewayEndpointKind"
        },
        {
          "type": "null"
        }
      ]
    },
    "execution_backend": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentExecutionBackend"
        },
        {
          "type": "null"
        }
      ]
    },
    "permission_mode": {
      "$ref": "#/$defs/TurnPermissionMode"
    },
    "selected_mode": {
      "anyOf": [
        {
          "$ref": "#/$defs/ThreadMode"
        },
        {
          "type": "null"
        }
      ]
    },
    "selected_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "selected_provider": {
      "type": [
        "string",
        "null"
      ]
    },
    "selected_reasoning_effort": {
      "type": [
        "string",
        "null"
      ]
    },
    "skill_picker": {
      "$ref": "#/$defs/ComposerSkillPickerProjection",
      "default": {
        "packs": [],
        "standalone": []
      }
    },
    "skill_selections": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/ComposerSkillSelection"
      }
    },
    "thread_id": {
      "type": "string"
    },
    "turn_id": {
      "type": "string"
    },
    "turn_model_provider": {
      "type": [
        "string",
        "null"
      ]
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "required": [
    "authorization_fingerprint",
    "workspace_id",
    "thread_id",
    "turn_id",
    "attachments",
    "capabilities",
    "permission_mode"
  ],
  "$defs": {
    "AcpConfigurationChoice": {
      "description": "An actually applied choice, in receive order. The descriptor identity is\nchecked before replay; opaque ids never determine dependency ordering.",
      "type": "object",
      "properties": {
        "config_id": {
          "type": "string"
        },
        "descriptor_fingerprint": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/SessionConfigOptionValue"
        }
      },
      "required": [
        "descriptor_fingerprint",
        "config_id",
        "value"
      ]
    },
    "AcpConfigurationVersion": {
      "type": "object",
      "properties": {
        "connection_id": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "connection_id",
        "revision"
      ]
    },
    "AcpTurnConfiguration": {
      "description": "Selection captured from a version-checked preparation, then frozen with the\nexisting launch/input. The actual admitted session revalidates descriptor\nidentity and every opaque value before dispatch. No elevated instructions.",
      "type": "object",
      "properties": {
        "additional_directories": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "configuration_replay": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/AcpConfigurationChoice"
          }
        },
        "continuation_requested": {
          "type": "boolean",
          "default": false
        },
        "descriptor_fingerprint": {
          "type": "string"
        },
        "expected": {
          "$ref": "#/$defs/AcpConfigurationVersion"
        },
        "initial_descriptor_fingerprint": {
          "type": "string",
          "default": ""
        },
        "mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_id": {
          "type": "string"
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/SessionConfigOptionValue"
          }
        }
      },
      "required": [
        "session_id",
        "expected",
        "descriptor_fingerprint",
        "values"
      ]
    },
    "AgentExecutionBackend": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "apiProvider"
            }
          },
          "required": [
            "type",
            "provider"
          ]
        },
        {
          "type": "object",
          "properties": {
            "runtime_id": {
              "type": "string"
            },
            "runtime_kind": {
              "$ref": "#/$defs/CLIAgentRuntimeKind"
            },
            "type": {
              "type": "string",
              "const": "cliAgentRuntime"
            }
          },
          "required": [
            "type",
            "runtime_id",
            "runtime_kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "runtime_id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "acpAgentRuntime"
            }
          },
          "required": [
            "type",
            "runtime_id"
          ]
        }
      ]
    },
    "ArtifactKind": {
      "type": "string",
      "enum": [
        "file",
        "text",
        "image",
        "audio",
        "video",
        "pdf",
        "spreadsheet",
        "archive",
        "json",
        "generated_image",
        "screenshot",
        "workspace_file",
        "directory_manifest",
        "unknown"
      ]
    },
    "ArtifactPreviewRef": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "blob_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "mime_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "projection_kind": {
          "$ref": "#/$defs/ArtifactProjectionKind"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/ArtifactProjectionStatus"
        },
        "version_id": {
          "type": "string"
        }
      },
      "required": [
        "projection_kind",
        "status",
        "artifact_id",
        "version_id"
      ]
    },
    "ArtifactProjectionKind": {
      "type": "string",
      "enum": [
        "plain_text",
        "thumbnail",
        "json_summary",
        "pdf_text"
      ]
    },
    "ArtifactProjectionStatus": {
      "type": "string",
      "enum": [
        "pending",
        "ready",
        "failed",
        "stale"
      ]
    },
    "ArtifactRef": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "mime_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "preview": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactPreviewRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/ArtifactStatus"
        },
        "version_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "artifact_id",
        "display_name",
        "kind",
        "status"
      ]
    },
    "ArtifactStatus": {
      "type": "string",
      "enum": [
        "ready",
        "pending",
        "quarantined",
        "deleted",
        "missing_external_source",
        "failed"
      ]
    },
    "CLIAgentRuntimeKind": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "codex",
            "claude",
            "opencode"
          ]
        },
        {
          "description": "The standard ACP transport, shared by every configured ACP instance.",
          "type": "string",
          "const": "acp"
        }
      ]
    },
    "ComposerAttachment": {
      "type": "object",
      "properties": {
        "file_name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ComposerAttachmentKind"
        },
        "path": {
          "type": "string"
        },
        "upload_state": {
          "$ref": "#/$defs/ComposerAttachmentUploadState"
        }
      },
      "required": [
        "path",
        "file_name",
        "kind",
        "upload_state"
      ]
    },
    "ComposerAttachmentKind": {
      "type": "string",
      "enum": [
        "Image",
        "File",
        "Audio",
        "Video"
      ]
    },
    "ComposerAttachmentUploadState": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Local",
            "Uploading"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Uploaded": {
              "type": "object",
              "properties": {
                "artifact": {
                  "$ref": "#/$defs/ArtifactRef"
                }
              },
              "required": [
                "artifact"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Uploaded"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Failed": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string"
                }
              },
              "required": [
                "error"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Failed"
          ]
        }
      ]
    },
    "ComposerCapability": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ComposerCapabilityKind"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "kind"
      ]
    },
    "ComposerCapabilityKind": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "Skill": {
              "type": "object",
              "properties": {
                "owner": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "skill_id": {
                  "$ref": "#/$defs/SkillId"
                },
                "slug": {
                  "type": "string"
                },
                "source_kind": {
                  "type": "string"
                }
              },
              "required": [
                "skill_id",
                "slug",
                "source_kind"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Skill"
          ]
        },
        {
          "type": "object",
          "properties": {
            "McpServer": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "scope_kind": {
                  "$ref": "#/$defs/McpScopeKind"
                }
              },
              "required": [
                "name",
                "scope_kind"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "McpServer"
          ]
        },
        {
          "type": "object",
          "properties": {
            "McpTool": {
              "type": "object",
              "properties": {
                "raw_tool_name": {
                  "type": "string"
                },
                "scope_kind": {
                  "$ref": "#/$defs/McpScopeKind"
                },
                "server_name": {
                  "type": "string"
                }
              },
              "required": [
                "server_name",
                "raw_tool_name",
                "scope_kind"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "McpTool"
          ]
        }
      ]
    },
    "ComposerSkillPickerProjection": {
      "type": "object",
      "properties": {
        "packs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SelectableSkillPackCapability"
          }
        },
        "standalone": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SelectableSkillCapability"
          }
        }
      },
      "required": [
        "standalone",
        "packs"
      ]
    },
    "ComposerSkillSelection": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "skill"
            },
            "pack_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SkillPackId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "skill_id": {
              "$ref": "#/$defs/SkillId"
            }
          },
          "required": [
            "kind",
            "skill_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "skill_pack"
            },
            "pack_id": {
              "$ref": "#/$defs/SkillPackId"
            }
          },
          "required": [
            "kind",
            "pack_id"
          ]
        }
      ]
    },
    "GatewayEndpointKind": {
      "type": "string",
      "enum": [
        "local",
        "remote"
      ]
    },
    "McpScopeKind": {
      "type": "string",
      "enum": [
        "workspace",
        "user"
      ]
    },
    "SelectablePackedSkillCapability": {
      "type": "object",
      "properties": {
        "member_key": {
          "type": "string"
        },
        "pack_id": {
          "$ref": "#/$defs/SkillPackId"
        },
        "skill": {
          "$ref": "#/$defs/SelectableSkillCapability"
        }
      },
      "required": [
        "pack_id",
        "member_key",
        "skill"
      ]
    },
    "SelectableSkillCapability": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "selectable": {
          "type": "boolean"
        },
        "skill_id": {
          "$ref": "#/$defs/SkillId"
        },
        "slug": {
          "type": "string"
        },
        "source_kind": {
          "type": "string"
        },
        "unavailable_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/SkillCapabilityUnavailableReason"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "key",
        "skill_id",
        "label",
        "display_name",
        "description",
        "slug",
        "source_kind",
        "selectable"
      ]
    },
    "SelectableSkillPackCapability": {
      "type": "object",
      "properties": {
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SelectablePackedSkillCapability"
          }
        },
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "pack_id": {
          "$ref": "#/$defs/SkillPackId"
        },
        "selectable": {
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "pack_id",
        "label",
        "children",
        "selectable"
      ]
    },
    "SessionConfigOptionValue": {
      "description": "The value to set for a session configuration option.\n\nThe `type` field acts as the discriminator in the serialized JSON form.\nWhen no `type` is present, the value is treated as a [`SessionConfigValueId`]\nvia the [`ValueId`](Self::ValueId) fallback variant.\n\nThe `type` discriminator describes the *shape* of the value, not the option\nkind. For example every option kind that picks from a list of ids\n(`select`, `radio`, …) would use [`ValueId`](Self::ValueId), while a\nfuture freeform text option would get its own variant.",
      "anyOf": [
        {
          "description": "A boolean value (`type: \"boolean\"`).",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "boolean"
            },
            "value": {
              "description": "The boolean value.",
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "A [`SessionConfigValueId`] string value.\n\nThis is the default when `type` is absent on the wire. Unknown `type`\nvalues with string payloads also gracefully deserialize into this\nvariant.",
          "type": "object",
          "properties": {
            "value": {
              "description": "The value ID.",
              "$ref": "#/$defs/SessionConfigValueId"
            }
          },
          "required": [
            "value"
          ]
        }
      ]
    },
    "SessionConfigValueId": {
      "description": "Unique identifier for a session configuration option value.",
      "type": "string"
    },
    "SkillCapabilityUnavailableReason": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "DisabledByPolicy"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Inactive": {
              "type": "object",
              "properties": {
                "status_reason": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "Inactive"
          ]
        }
      ]
    },
    "SkillId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "SkillPackId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "ThreadMode": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Message",
            "Agent"
          ]
        },
        {
          "description": "Compatibility default for pre-Epic-6 persisted and wire values. New\nuser-thread creation selects `Message` explicitly.",
          "type": "string",
          "const": "Chat"
        }
      ]
    },
    "TurnCLIRuntimeOptions": {
      "type": "object",
      "properties": {
        "acp_configuration": {
          "anyOf": [
            {
              "$ref": "#/$defs/AcpTurnConfiguration"
            },
            {
              "type": "null"
            }
          ]
        },
        "effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "personality": {
          "type": [
            "string",
            "null"
          ]
        },
        "sandbox": true,
        "steer_if_active": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "TurnPermissionMode": {
      "type": "string",
      "enum": [
        "full_access",
        "auto_accept_edits",
        "supervised"
      ]
    }
  }
}