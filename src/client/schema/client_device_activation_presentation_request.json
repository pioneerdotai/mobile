{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClientDeviceActivationPresentationRequest",
  "type": "object",
  "properties": {
    "app_url_scheme": {
      "$ref": "#/$defs/PioneerAppUrlScheme"
    },
    "created_device": {
      "$ref": "#/$defs/AuthDeviceCreateResponse"
    },
    "gateway_base_url": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "gateway_base_url",
    "created_device",
    "app_url_scheme"
  ],
  "$defs": {
    "AuthDeviceCreateResponse": {
      "type": "object",
      "properties": {
        "activation_code": {
          "type": "string"
        },
        "device_id": {
          "$ref": "#/$defs/DeviceId"
        },
        "expires_at_unix": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "gateway_id": {
          "$ref": "#/$defs/GatewayId"
        },
        "session_id": {
          "$ref": "#/$defs/AuthSessionId"
        }
      },
      "required": [
        "device_id",
        "session_id",
        "activation_code",
        "expires_at_unix",
        "gateway_id"
      ]
    },
    "AuthSessionId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "DeviceId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "GatewayId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "PioneerAppUrlScheme": {
      "description": "The custom URL scheme owned by a Pioneer application build.\n\nDebug builds default to the development scheme so they can coexist with an\ninstalled production application. Release packaging can override the\ndefault at compile time with `PIONEER_APP_URL_SCHEME`.",
      "type": "string",
      "enum": [
        "pioneer",
        "pioneer-dev"
      ]
    }
  }
}