{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClientAccessChangePlanRequestDto",
  "type": "object",
  "properties": {
    "active_thread_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "active_workspace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "change_sequence": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "connection_generation": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "known_threads": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ThreadAuthorizationScope"
      }
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "connection_generation",
    "change_sequence",
    "known_threads"
  ],
  "$defs": {
    "ThreadAuthorizationScope": {
      "type": "object",
      "properties": {
        "thread_id": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "thread_id",
        "workspace_id"
      ]
    }
  }
}