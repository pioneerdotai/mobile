{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SettingsModelPickerPublication",
  "type": "object",
  "properties": {
    "closed": {
      "type": "boolean"
    },
    "context_rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ContextWindowRow"
      }
    },
    "default_reasoning_only": {
      "type": "boolean"
    },
    "owner_generation": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "picker_id": {
      "type": "string"
    },
    "selected_context_authority": {
      "type": [
        "string",
        "null"
      ]
    },
    "selected_context_window": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "selected_reasoning_effort": {
      "type": [
        "string",
        "null"
      ]
    },
    "selected_service_mode": {
      "anyOf": [
        {
          "$ref": "#/$defs/NativeServiceModeSelection"
        },
        {
          "type": "null"
        }
      ]
    },
    "selector": {
      "$ref": "#/$defs/ProviderModelSelectorState"
    },
    "service_rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ServiceModeRow"
      }
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "required": [
    "picker_id",
    "owner_generation",
    "workspace_id",
    "selector",
    "closed"
  ],
  "$defs": {
    "CLIAgentRuntimeKind": {
      "type": "string",
      "enum": [
        "codex",
        "claude",
        "opencode"
      ]
    },
    "ContextWindowRow": {
      "description": "Model-scoped context choices. Shells only localize the Auto/up-to labels.",
      "type": "object",
      "properties": {
        "selected": {
          "type": "boolean"
        },
        "tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "window": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "tokens",
        "selected"
      ]
    },
    "NativeServiceModeSelection": {
      "description": "Explicit choice uses the existing endpoint/credential/model authority proof.\nAbsence means Standard; Inherit belongs to the enclosing model selection.",
      "type": "object",
      "properties": {
        "authority": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "authority"
      ]
    },
    "OpenAiTier": {
      "type": "string",
      "enum": [
        "priority",
        "flex",
        "ultrafast"
      ]
    },
    "ProviderContextTiers": {
      "description": "Authority-scoped, normalized context choices. Absence on a discovery DTO\nmeans unavailable metadata, distinct from a confirmed model without tiers.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "no_tiers"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "excluded"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "invalid"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "price_order_confirmed": {
              "type": "boolean"
            },
            "status": {
              "type": "string",
              "const": "tiered"
            },
            "windows": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0
              }
            }
          },
          "required": [
            "status",
            "windows",
            "price_order_confirmed"
          ]
        }
      ]
    },
    "ProviderModelCapabilities": {
      "type": "object",
      "properties": {
        "embeddings": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "fine_tuning": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "input_modalities": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "json_output": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "output_modalities": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "reasoning": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderModelReasoningCapabilities"
            },
            {
              "type": "null"
            }
          ]
        },
        "streaming": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "thinking": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "tool_calling": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "transcription": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "vision": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "ProviderModelInfo": {
      "type": "object",
      "properties": {
        "active": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "capabilities": {
          "$ref": "#/$defs/ProviderModelCapabilities"
        },
        "context_authority": {
          "type": [
            "string",
            "null"
          ]
        },
        "context_tiers": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderContextTiers"
            },
            {
              "type": "null"
            }
          ]
        },
        "created": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "family": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "lifecycle_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "limits": {
          "$ref": "#/$defs/ProviderModelLimits"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "owned_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "pricing": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderModelPricing"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider": {
          "type": "string"
        },
        "service_modes": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceServiceModes"
            },
            {
              "type": "null"
            }
          ]
        },
        "transcription": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderTranscriptionModelMetadata"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "provider",
        "limits",
        "capabilities"
      ]
    },
    "ProviderModelLimits": {
      "type": "object",
      "properties": {
        "context_window": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "max_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "max_output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      }
    },
    "ProviderModelPricing": {
      "type": "object",
      "properties": {
        "image": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "input_token": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "output_token": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "request": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      }
    },
    "ProviderModelReasoningCapabilities": {
      "type": "object",
      "properties": {
        "default_effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "effort_options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mandatory": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReasoningCapabilitySource"
            },
            {
              "type": "null"
            }
          ]
        },
        "supported": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "supports_token_budget": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "ProviderModelSelectorMode": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Chat",
            "SelfImprovement",
            "Embeddings",
            "Transcription"
          ]
        },
        {
          "description": "Chat models used outside the Native turn/compaction execution pipeline.",
          "type": "string",
          "const": "AuxiliaryChat"
        }
      ]
    },
    "ProviderModelSelectorState": {
      "type": "object",
      "properties": {
        "cli_runtimes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RuntimeSummary"
          }
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "loading_cli_runtimes": {
          "type": "boolean"
        },
        "loading_models": {
          "type": "boolean"
        },
        "loading_providers": {
          "type": "boolean"
        },
        "mode": {
          "$ref": "#/$defs/ProviderModelSelectorMode"
        },
        "models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProviderModelInfo"
          }
        },
        "providers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProviderSummary"
          }
        },
        "selected_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "selected_provider": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "providers",
        "cli_runtimes",
        "models",
        "mode",
        "loading_providers",
        "loading_cli_runtimes",
        "loading_models"
      ]
    },
    "ProviderSummary": {
      "type": "object",
      "properties": {
        "api_key_configured": {
          "type": "boolean"
        },
        "available": {
          "description": "The gateway can construct this provider in the selected workspace.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "base_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "capabilities": {
          "$ref": "#/$defs/ProviderSummaryCapabilities",
          "default": {
            "embeddings": false,
            "self_improvement": false,
            "transcription": false
          }
        },
        "name": {
          "type": "string"
        },
        "proxy_url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ]
    },
    "ProviderSummaryCapabilities": {
      "type": "object",
      "properties": {
        "embeddings": {
          "type": "boolean",
          "default": false
        },
        "self_improvement": {
          "description": "Gateway-authoritative eligibility for the API-only self-improvement\nmodel selectors.",
          "type": "boolean",
          "default": false
        },
        "transcription": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "ProviderTranscriptionModelMetadata": {
      "type": "object",
      "properties": {
        "accuracy_score": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "download_size_mb": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "engine": {
          "type": "string"
        },
        "recommended": {
          "type": "boolean"
        },
        "speed_score": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "supported_languages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supports_language_selection": {
          "type": "boolean"
        },
        "supports_translation": {
          "type": "boolean"
        }
      },
      "required": [
        "engine",
        "download_size_mb",
        "accuracy_score",
        "speed_score",
        "supports_translation",
        "supported_languages",
        "supports_language_selection",
        "recommended"
      ]
    },
    "ReasoningCapabilitySource": {
      "type": "string",
      "enum": [
        "provider_metadata",
        "cli_metadata",
        "config_override",
        "unknown"
      ]
    },
    "RuntimeAccountSnapshot": {
      "type": "object",
      "properties": {
        "account_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "auth_method": {
          "type": [
            "string",
            "null"
          ]
        },
        "authenticated": {
          "type": "boolean"
        },
        "display_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "email": {
          "type": [
            "string",
            "null"
          ]
        },
        "plan": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "authenticated"
      ]
    },
    "RuntimeCapabilities": {
      "type": "object",
      "properties": {
        "supports_approvals": {
          "type": "boolean"
        },
        "supports_apps": {
          "type": "boolean"
        },
        "supports_auth_management": {
          "type": "boolean"
        },
        "supports_command_approvals": {
          "type": "boolean"
        },
        "supports_compaction": {
          "type": "boolean"
        },
        "supports_diff_updates": {
          "type": "boolean"
        },
        "supports_file_change_approvals": {
          "type": "boolean"
        },
        "supports_fork": {
          "type": "boolean"
        },
        "supports_generated_schema_probe": {
          "type": "boolean"
        },
        "supports_goal": {
          "type": "boolean"
        },
        "supports_history_read": {
          "type": "boolean"
        },
        "supports_interrupt": {
          "type": "boolean"
        },
        "supports_mcp_tools": {
          "type": "boolean",
          "default": false
        },
        "supports_model_list": {
          "type": "boolean"
        },
        "supports_resume": {
          "type": "boolean"
        },
        "supports_review": {
          "type": "boolean"
        },
        "supports_skills": {
          "type": "boolean",
          "default": false
        },
        "supports_steer": {
          "type": "boolean"
        },
        "supports_thread_archive": {
          "type": "boolean"
        },
        "supports_threads": {
          "type": "boolean"
        },
        "supports_user_input_requests": {
          "type": "boolean"
        }
      },
      "required": [
        "supports_threads",
        "supports_resume",
        "supports_fork",
        "supports_steer",
        "supports_interrupt",
        "supports_approvals",
        "supports_file_change_approvals",
        "supports_command_approvals",
        "supports_user_input_requests",
        "supports_model_list",
        "supports_apps",
        "supports_review",
        "supports_compaction",
        "supports_goal",
        "supports_diff_updates",
        "supports_history_read",
        "supports_thread_archive",
        "supports_auth_management",
        "supports_generated_schema_probe"
      ]
    },
    "RuntimeDiagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "level": {
          "$ref": "#/$defs/RuntimeDiagnosticLevel"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "level",
        "code",
        "message"
      ]
    },
    "RuntimeDiagnosticLevel": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "error"
      ]
    },
    "RuntimeStatus": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "disabled"
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "binary_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "state": {
              "type": "string",
              "const": "missing_binary"
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "const": "spawn_failed"
            }
          },
          "required": [
            "state",
            "message"
          ]
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "initializing"
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "needs_auth"
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "ready"
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "const": "degraded"
            }
          },
          "required": [
            "state",
            "message"
          ]
        },
        {
          "type": "object",
          "properties": {
            "minimum_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "state": {
              "type": "string",
              "const": "unsupported_version"
            },
            "version": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "const": "error"
            }
          },
          "required": [
            "state",
            "message"
          ]
        }
      ]
    },
    "RuntimeSummary": {
      "type": "object",
      "properties": {
        "account": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuntimeAccountSnapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "binary_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "capabilities": {
          "$ref": "#/$defs/RuntimeCapabilities"
        },
        "debug_native_events_enabled": {
          "type": "boolean"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RuntimeDiagnostic"
          }
        },
        "display_name": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "home_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/CLIAgentRuntimeKind"
        },
        "models_refreshed_at_unix_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "proxy_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "recent_stderr": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "runtime_id": {
          "type": "string"
        },
        "shadow_home_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/RuntimeStatus"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "runtime_id",
        "kind",
        "display_name",
        "enabled",
        "status",
        "capabilities"
      ]
    },
    "ServiceModeDescriptor": {
      "description": "Retains conditional/partial source prices without flattening context bands\nor treating absent prices as Standard. Pricing must prove applicability\nbefore passing these rates to the existing estimator.",
      "type": "object",
      "properties": {
        "cost": true,
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "parameters": {
          "$ref": "#/$defs/ServiceModeParameters"
        },
        "source_api": {
          "type": "string"
        },
        "source_model": {
          "type": "string"
        },
        "source_provider": {
          "type": "string"
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "label",
        "parameters",
        "source_provider",
        "source_model",
        "source_api"
      ]
    },
    "ServiceModeParameters": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "neutral"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "open_ai_standard"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "anthropic_standard"
            }
          },
          "additionalProperties": false,
