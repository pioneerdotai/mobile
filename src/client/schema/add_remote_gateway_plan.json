{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AddRemoteGatewayPlan",
  "type": "object",
  "properties": {
    "endpoint": {
      "$ref": "#/$defs/GatewayEndpoint"
    },
    "previous_endpoint": {
      "anyOf": [
        {
          "$ref": "#/$defs/GatewayEndpoint"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "endpoint"
  ],
  "$defs": {
    "GatewayEndpoint": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/GatewayEndpointKind"
        },
        "name": {
          "type": "string"
        },
        "server_gateway_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/GatewayId"
            },
            {
              "type": "null"
            }
          ]
        },
        "service_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "workspace_id": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "address",
        "kind"
      ]
    },
    "GatewayEndpointKind": {
      "type": "string",
      "enum": [
        "local",
        "remote"
      ]
    },
    "GatewayId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    }
  }
}