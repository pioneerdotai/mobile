{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClientArtifactDownloadRequest",
  "type": "object",
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "identity": {
      "$ref": "#/$defs/ArtifactActionIdentity"
    },
    "operation_id": {
      "type": "string"
    },
    "thread_id": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "version_id": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "identity",
    "operation_id",
    "workspace_id",
    "artifact_id"
  ],
  "$defs": {
    "ArtifactActionIdentity": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "generation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "thread_id": {
          "type": "string"
        },
        "version_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "thread_id",
        "artifact_id",
        "generation"
      ]
    }
  }
}