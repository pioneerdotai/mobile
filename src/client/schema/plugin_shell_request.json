{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PluginShellRequest",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "configure_oauth"
        },
        "redirect_uri": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "redirect_uri"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "poll_oauth"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ]
    },
    {
      "type": "object",
      "properties": {
        "draft_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "kind": {
          "type": "string",
          "const": "composer_picker"
        },
        "query": {
          "type": "string"
        },
        "thread_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "thread_id",
        "draft_id",
        "query"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "oauth_callback"
        },
        "url": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "url"
      ]
    },
    {
      "type": "object",
      "properties": {
        "cancelled": {
          "type": "boolean"
        },
        "flow_id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "browser_result"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "flow_id",
        "cancelled"
      ]
    },
    {
      "type": "object",
      "properties": {
        "expected_connection": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "file_uri": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "start_archive"
        },
        "target": {
          "$ref": "#/$defs/SkillUploadTarget"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "workspace_id",
        "expected_connection",
        "target",
        "file_uri"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "cancel_upload"
        },
        "operation_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "workspace_id",
        "operation_id"
      ]
    }
  ],
  "$defs": {
    "SkillId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "SkillPackId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "SkillUploadTarget": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "plugin_install"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "plugin_preview"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "expected_revision": {
              "type": "integer",
              "format": "int64"
            },
            "kind": {
              "type": "string",
              "const": "plugin_update_preview"
            },
            "plugin_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "plugin_id",
            "expected_revision"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "install"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "update"
            },
            "skill_id": {
              "$ref": "#/$defs/SkillId"
            }
          },
          "required": [
            "kind",
            "skill_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "update_pack"
            },
            "pack_id": {
              "$ref": "#/$defs/SkillPackId"
            }
          },
          "required": [
            "kind",
            "pack_id"
          ]
        }
      ]
    }
  }
}