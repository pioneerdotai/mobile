{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AppViewPublication",
  "type": "object",
  "properties": {
    "base_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "development": {
      "type": "boolean"
    },
    "expires_at": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "state": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "url": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "development",
    "state",
    "title"
  ]
}