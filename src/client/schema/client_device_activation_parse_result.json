{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClientDeviceActivationParseResult",
  "type": "object",
  "properties": {
    "activation_code": {
      "type": "string"
    },
    "gateway_base_url": {
      "type": "string"
    },
    "gateway_id": {
      "$ref": "#/$defs/GatewayId"
    }
  },
  "required": [
    "gateway_base_url",
    "gateway_id",
    "activation_code"
  ],
  "$defs": {
    "GatewayId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    }
  }
}