{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThreadScopePresentation",
  "type": "object",
  "properties": {
    "candidate_members": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ThreadParticipantRow"
      }
    },
    "capabilities": {
      "$ref": "#/$defs/ThreadPresentationCapabilities"
    },
    "is_closed": {
      "type": "boolean"
    },
    "is_user_thread": {
      "type": "boolean"
    },
    "participants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ThreadParticipantRow"
      }
    },
    "show_workspace_explanation": {
      "type": "boolean"
    },
    "visibility": {
      "$ref": "#/$defs/ThreadVisibilityPresentation"
    }
  },
  "additionalProperties": false,
  "required": [
    "visibility",
    "is_user_thread",
    "is_closed",
    "capabilities",
    "participants",
    "candidate_members",
    "show_workspace_explanation"
  ],
  "$defs": {
    "PrincipalId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "ThreadParticipantRow": {
      "type": "object",
      "properties": {
        "avatar_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "can_remove": {
          "type": "boolean"
        },
        "display_name": {
          "type": "string"
        },
        "is_current_principal": {
          "type": "boolean"
        },
        "nickname": {
          "type": "string"
        },
        "principal_id": {
          "$ref": "#/$defs/PrincipalId"
        }
      },
      "additionalProperties": false,
      "required": [
        "principal_id",
        "display_name",
        "nickname",
        "is_current_principal",
        "can_remove"
      ]
    },
    "ThreadPresentationCapabilities": {
      "type": "object",
      "properties": {
        "can_manage_private_participants": {
          "type": "boolean"
        },
        "can_manage_thread": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "can_manage_thread",
        "can_manage_private_participants"
      ]
    },
    "ThreadVisibilityPresentation": {
      "type": "string",
      "enum": [
        "private",
        "workspace",
        "unknown"
      ]
    }
  }
}