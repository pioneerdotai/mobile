{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClientCurrentPrincipalPresentationRequest",
  "type": "object",
  "properties": {
    "auth": {
      "$ref": "#/$defs/AuthMeResponse"
    },
    "capability_snapshot": {
      "$ref": "#/$defs/AuthorizationCapabilitySnapshot"
    },
    "visible_member": {
      "anyOf": [
        {
          "$ref": "#/$defs/MemberSummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "additionalProperties": false,
  "required": [
    "auth",
    "capability_snapshot"
  ],
  "$defs": {
    "AuthDeviceSnapshot": {
      "type": "object",
      "properties": {
        "client_kind": {
          "$ref": "#/$defs/ClientKind"
        },
        "display_name": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/DeviceId"
        },
        "installation_id": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/DeviceStatus"
        }
      },
      "required": [
        "id",
        "installation_id",
        "display_name",
        "client_kind",
        "status"
      ]
    },
    "AuthGatewaySnapshot": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/GatewayId"
        }
      },
      "required": [
        "id"
      ]
    },
    "AuthMeResponse": {
      "type": "object",
      "properties": {
        "device": {
          "$ref": "#/$defs/AuthDeviceSnapshot"
        },
        "gateway": {
          "$ref": "#/$defs/AuthGatewaySnapshot"
        },
        "principal": {
          "$ref": "#/$defs/AuthPrincipalSnapshot"
        },
        "role_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/RoleKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "session": {
          "$ref": "#/$defs/AuthSessionSnapshot"
        }
      },
      "required": [
        "gateway",
        "principal",
        "device",
        "session"
      ]
    },
    "AuthPrincipalSnapshot": {
      "type": "object",
      "properties": {
        "avatar_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "display_name": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/PrincipalId"
        },
        "kind": {
          "$ref": "#/$defs/PrincipalKind"
        },
        "nickname": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "display_name",
        "nickname"
      ]
    },
    "AuthSessionId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "AuthSessionSnapshot": {
      "type": "object",
      "properties": {
        "device_id": {
          "$ref": "#/$defs/DeviceId"
        },
        "id": {
          "$ref": "#/$defs/AuthSessionId"
        },
        "refresh_expires_at_unix": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "refresh_generation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/AuthSessionStatus"
        },
        "token_family_id": {
          "$ref": "#/$defs/TokenFamilyId"
        }
      },
      "required": [
        "id",
        "device_id",
        "token_family_id",
        "status",
        "refresh_generation",
        "refresh_expires_at_unix"
      ]
    },
    "AuthSessionStatus": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "revoked",
        "expired"
      ]
    },
    "AuthorizationCapabilitySnapshot": {
      "type": "object",
      "properties": {
        "authorization_revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "global": {
          "$ref": "#/$defs/AuthorizationGlobalCapabilities"
        },
        "principal_id": {
          "$ref": "#/$defs/PrincipalId"
        },
        "role_key": {
          "description": "Stable built-in role identifier. Clients may display this value but\nmust never derive permissions from it.",
          "type": "string"
        },
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "thread": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuthorizationThreadCapabilitySnapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "workspace": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuthorizationWorkspaceCapabilitySnapshot"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "schema_version",
        "authorization_revision",
        "principal_id",
        "role_key",
        "global"
      ]
    },
    "AuthorizationGlobalCapabilities": {
      "type": "object",
      "properties": {
        "can_create_invitation": {
          "type": "boolean"
        },
        "can_create_workspace": {
          "type": "boolean"
        },
        "can_manage_all_threads": {
          "type": "boolean"
        },
        "can_manage_capabilities": {
          "type": "boolean"
        },
        "can_manage_gateway_settings": {
          "type": "boolean"
        },
        "can_manage_member_lifecycle": {
          "type": "boolean"
        },
        "can_manage_own_sessions": {
          "type": "boolean"
        },
        "can_view_invitations": {
          "type": "boolean"
        },
        "can_view_member_directory": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "can_create_workspace",
        "can_manage_gateway_settings",
        "can_manage_capabilities",
        "can_manage_all_threads",
        "can_view_invitations",
        "can_create_invitation",
        "can_view_member_directory",
        "can_manage_member_lifecycle",
        "can_manage_own_sessions"
      ]
    },
    "AuthorizationThreadCapabilities": {
      "type": "object",
      "properties": {
        "can_control_cli_runtime": {
          "type": "boolean"
        },
        "can_create_task": {
          "type": "boolean"
        },
        "can_manage": {
          "type": "boolean"
        },
        "can_manage_private_participants": {
          "type": "boolean"
        },
        "can_move": {
          "type": "boolean"
        },
        "can_read": {
          "type": "boolean"
        },
        "can_read_artifacts": {
          "type": "boolean"
        },
        "can_respond_to_agent_requests": {
          "type": "boolean"
        },
        "can_start_turn": {
          "type": "boolean"
        },
        "can_write": {
          "type": "boolean"
        },
        "can_write_artifacts": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "can_read",
        "can_write",
        "can_start_turn",
        "can_respond_to_agent_requests",
        "can_control_cli_runtime",
        "can_create_task",
        "can_read_artifacts",
        "can_write_artifacts",
        "can_manage",
        "can_manage_private_participants",
        "can_move"
      ]
    },
    "AuthorizationThreadCapabilitySnapshot": {
      "type": "object",
      "properties": {
        "capabilities": {
          "$ref": "#/$defs/AuthorizationThreadCapabilities"
        },
        "thread_id": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "workspace_id",
        "thread_id",
        "capabilities"
      ]
    },
    "AuthorizationWorkspaceCapabilities": {
      "type": "object",
      "properties": {
        "can_add_member": {
          "type": "boolean"
        },
        "can_create_thread": {
          "type": "boolean"
        },
        "can_list_members": {
          "type": "boolean"
        },
        "can_manage": {
          "type": "boolean"
        },
        "can_read": {
          "type": "boolean"
        },
        "can_remove_member": {
          "type": "boolean"
        },
        "can_run_tasks": {
          "type": "boolean"
        },
        "can_use_cli_runtimes": {
          "type": "boolean"
        },
        "can_use_mcp": {
          "type": "boolean"
        },
        "can_use_providers": {
          "type": "boolean"
        },
        "can_use_skills": {
          "type": "boolean"
        },
        "thread_visibility_options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ThreadVisibility"
          }
        },
        "turn_permission_modes": {
          "description": "Permission modes this principal may select for an agent turn in this\nworkspace. The Gateway applies the same role cap again at execution.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TurnPermissionMode"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "can_read",
        "can_create_thread",
        "can_manage",
        "can_use_providers",
        "can_use_cli_runtimes",
        "can_use_skills",
        "can_use_mcp",
        "can_run_tasks",
        "turn_permission_modes",
        "can_list_members",
        "can_add_member",
        "can_remove_member",
        "thread_visibility_options"
      ]
    },
    "AuthorizationWorkspaceCapabilitySnapshot": {
      "type": "object",
      "properties": {
        "capabilities": {
          "$ref": "#/$defs/AuthorizationWorkspaceCapabilities"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "workspace_id",
        "capabilities"
      ]
    },
    "ClientKind": {
      "type": "string",
      "enum": [
        "desktop",
        "mobile",
        "other"
      ]
    },
    "DeviceId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "DeviceStatus": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "revoked"
      ]
    },
    "GatewayId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "MemberSummary": {
      "type": "object",
      "properties": {
        "avatar_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "display_name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/PrincipalKind"
        },
        "nickname": {
          "type": "string"
        },
        "principal_id": {
          "$ref": "#/$defs/PrincipalId"
        },
        "role_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/RoleKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/PrincipalStatus"
        }
      },
      "required": [
        "principal_id",
        "kind",
        "display_name",
        "nickname",
        "status"
      ]
    },
    "PrincipalId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "PrincipalKind": {
      "type": "string",
      "enum": [
        "superuser",
        "user"
      ]
    },
    "PrincipalStatus": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "removed"
      ]
    },
    "RoleKey": {
      "type": "string",
      "maxLength": 32,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "ThreadVisibility": {
      "description": "User-selectable visibility for ordinary user threads.\n\nInternal task/system threads deliberately have no public selectable value.",
      "type": "string",
      "enum": [
        "private",
        "workspace"
      ]
    },
    "TokenFamilyId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "TurnPermissionMode": {
      "type": "string",
      "enum": [
        "full_access",
        "auto_accept_edits",
        "supervised"
      ]
    }
  }
}