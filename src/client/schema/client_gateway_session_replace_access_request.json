{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClientGatewaySessionReplaceAccessRequest",
  "type": "object",
  "properties": {
    "access_expires_at_unix": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "access_token": {
      "type": "string"
    },
    "device_id": {
      "$ref": "#/$defs/DeviceId"
    },
    "endpoint": {
      "$ref": "#/$defs/GatewayEndpoint"
    },
    "refresh_leeway_seconds": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "server_gateway_id": {
      "$ref": "#/$defs/GatewayId"
    },
    "session_id": {
      "$ref": "#/$defs/AuthSessionId"
    },
    "timings": {
      "$ref": "#/$defs/ClientGatewayWsTimings"
    }
  },
  "additionalProperties": false,
  "required": [
    "endpoint",
    "server_gateway_id",
    "session_id",
    "device_id",
    "access_token",
    "access_expires_at_unix",
    "refresh_leeway_seconds",
    "timings"
  ],
  "$defs": {
    "AuthSessionId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "ClientGatewayWsTimings": {
      "type": "object",
      "properties": {
        "connect_timeout_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "ping_interval_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "pong_timeout_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "reconnect_initial_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "reconnect_jitter_percent": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "reconnect_max_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "connect_timeout_ms",
        "ping_interval_ms",
        "pong_timeout_ms",
        "reconnect_initial_ms",
        "reconnect_max_ms",
        "reconnect_jitter_percent"
      ]
    },
    "DeviceId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "GatewayEndpoint": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/GatewayEndpointKind"
        },
        "name": {
          "type": "string"
        },
        "server_gateway_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/GatewayId"
            },
            {
              "type": "null"
            }
          ]
        },
        "service_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "workspace_id": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "address",
        "kind"
      ]
    },
    "GatewayEndpointKind": {
      "type": "string",
      "enum": [
        "local",
        "remote"
      ]
    },
    "GatewayId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    }
  }
}