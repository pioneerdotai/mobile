{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClientMemberAvatarCacheRequest",
  "type": "object",
  "properties": {
    "avatar_revision": {
      "type": "string"
    },
    "principal_id": {
      "$ref": "#/$defs/PrincipalId"
    }
  },
  "additionalProperties": false,
  "required": [
    "principal_id",
    "avatar_revision"
  ],
  "$defs": {
    "PrincipalId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    }
  }
}