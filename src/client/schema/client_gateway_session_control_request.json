{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClientGatewaySessionControlRequest",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "endpoint_id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "suspend"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "endpoint_id"
      ]
    },
    {
      "type": "object",
      "properties": {
        "endpoint_id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "clear"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "endpoint_id"
      ]
    },
    {
      "type": "object",
      "properties": {
        "connection_id": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "endpoint_id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "disconnected"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "endpoint_id"
      ]
    },
    {
      "type": "object",
      "properties": {
        "endpoint_id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "stop"
        },
        "reason": {
          "$ref": "#/$defs/SessionTerminalReason"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "endpoint_id",
        "reason"
      ]
    }
  ],
  "$defs": {
    "SessionTerminalReason": {
      "type": "string",
      "enum": [
        "authentication_required",
        "session_revoked",
        "session_expired",
        "session_compromised",
        "principal_suspended",
        "principal_removed",
        "gateway_identity_mismatch",
        "secure_storage_failed",
        "refresh_outcome_unknown",
        "refresh_credential_invalid"
      ]
    }
  }
}