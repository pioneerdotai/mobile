{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VoiceTurnContext",
  "description": "Frozen non-audio composer context for voice turn materialization.\n\n`prepared_input` is for existing prepared `UserInput` references such as\nartifacts/local attachment references. It must not contain the future voice\ntranscript; the gateway prepends the transcript as `UserInput::Text` after\nsuccessful transcription.",
  "type": "object",
  "properties": {
    "capabilities": {
      "description": "Selected skills, MCP tools/servers and related turn capabilities.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/TurnCapability"
      }
    },
    "cli_runtime_options": {
      "anyOf": [
        {
          "$ref": "#/$defs/TurnCLIRuntimeOptions"
        },
        {
          "type": "null"
        }
      ]
    },
    "execution_backend": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentExecutionBackend"
        },
        {
          "type": "null"
        }
      ]
    },
    "mode": {
      "anyOf": [
        {
          "$ref": "#/$defs/ThreadMode"
        },
        {
          "type": "null"
        }
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_provider": {
      "type": [
        "string",
        "null"
      ]
    },
    "permission_profile": {
      "description": "Agent permission profile for the eventual turn.\n\nThis is not the platform microphone permission. Microphone permission\nstays client/platform-local and is reported through voice status/errors.",
      "anyOf": [
        {
          "$ref": "#/$defs/TurnPermissionProfileSelection"
        },
        {
          "type": "null"
        }
      ]
    },
    "prepared_input": {
      "description": "Existing prepared composer inputs such as artifact/file references.\n\nThis vector must not contain audio bytes or the future transcript. On\ncancel, dropping this context must not create a turn; already completed\nupload/cache side effects are handled by the existing attachment flow.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/UserInput"
      }
    },
    "reasoning": {
      "anyOf": [
        {
          "$ref": "#/$defs/TurnReasoningSelection"
        },
        {
          "type": "null"
        }
      ]
    },
    "sandbox_policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/SandboxPolicy"
        },
        {
          "type": "null"
        }
      ]
    },
    "thread_id": {
      "description": "Thread that receives the gateway-created turn after transcription.",
      "type": "string"
    },
    "turn_id": {
      "description": "Client-planned turn id reserved before any audio chunk is accepted.",
      "type": "string"
    },
    "workspace_id": {
      "description": "Workspace active when the voice session starts.\n\n`TurnStartParams` is still thread-scoped; the gateway keeps the\nworkspace here to validate/session-route the frozen voice context.",
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "thread_id",
    "turn_id"
  ],
  "$defs": {
    "AcpConfigurationChoice": {
      "description": "An actually applied choice, in receive order. The descriptor identity is\nchecked before replay; opaque ids never determine dependency ordering.",
      "type": "object",
      "properties": {
        "config_id": {
          "type": "string"
        },
        "descriptor_fingerprint": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/SessionConfigOptionValue"
        }
      },
      "required": [
        "descriptor_fingerprint",
        "config_id",
        "value"
      ]
    },
    "AcpConfigurationVersion": {
      "type": "object",
      "properties": {
        "connection_id": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "connection_id",
        "revision"
      ]
    },
    "AcpTurnConfiguration": {
      "description": "Selection captured from a version-checked preparation, then frozen with the\nexisting launch/input. The actual admitted session revalidates descriptor\nidentity and every opaque value before dispatch. No elevated instructions.",
      "type": "object",
      "properties": {
        "additional_directories": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "configuration_replay": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/AcpConfigurationChoice"
          }
        },
        "continuation_requested": {
          "type": "boolean",
          "default": false
        },
        "descriptor_fingerprint": {
          "type": "string"
        },
        "expected": {
          "$ref": "#/$defs/AcpConfigurationVersion"
        },
        "initial_descriptor_fingerprint": {
          "type": "string",
          "default": ""
        },
        "mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_id": {
          "type": "string"
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/SessionConfigOptionValue"
          }
        }
      },
      "required": [
        "session_id",
        "expected",
        "descriptor_fingerprint",
        "values"
      ]
    },
    "AgentExecutionBackend": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "apiProvider"
            }
          },
          "required": [
            "type",
            "provider"
          ]
        },
        {
          "type": "object",
          "properties": {
            "runtime_id": {
              "type": "string"
            },
            "runtime_kind": {
              "$ref": "#/$defs/CLIAgentRuntimeKind"
            },
            "type": {
              "type": "string",
              "const": "cliAgentRuntime"
            }
          },
          "required": [
            "type",
            "runtime_id",
            "runtime_kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "runtime_id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "acpAgentRuntime"
            }
          },
          "required": [
            "type",
            "runtime_id"
          ]
        }
      ]
    },
    "ByteRange": {
      "type": "object",
      "properties": {
        "end": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "start": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "start",
        "end"
      ]
    },
    "CLIAgentRuntimeKind": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "codex",
            "claude",
            "opencode"
          ]
        },
        {
          "description": "The standard ACP transport, shared by every configured ACP instance.",
          "type": "string",
          "const": "acp"
        }
      ]
    },
    "McpScopeKind": {
      "type": "string",
      "enum": [
        "workspace",
        "user"
      ]
    },
    "SandboxMode": {
      "type": "string",
      "enum": [
        "FullAccess"
      ]
    },
    "SandboxPolicy": {
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "#/$defs/SandboxMode"
        }
      },
      "required": [
        "mode"
      ]
    },
    "SessionConfigOptionValue": {
      "description": "The value to set for a session configuration option.\n\nThe `type` field acts as the discriminator in the serialized JSON form.\nWhen no `type` is present, the value is treated as a [`SessionConfigValueId`]\nvia the [`ValueId`](Self::ValueId) fallback variant.\n\nThe `type` discriminator describes the *shape* of the value, not the option\nkind. For example every option kind that picks from a list of ids\n(`select`, `radio`, …) would use [`ValueId`](Self::ValueId), while a\nfuture freeform text option would get its own variant.",
      "anyOf": [
        {
          "description": "A boolean value (`type: \"boolean\"`).",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "boolean"
            },
            "value": {
              "description": "The boolean value.",
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "A [`SessionConfigValueId`] string value.\n\nThis is the default when `type` is absent on the wire. Unknown `type`\nvalues with string payloads also gracefully deserialize into this\nvariant.",
          "type": "object",
          "properties": {
            "value": {
              "description": "The value ID.",
              "$ref": "#/$defs/SessionConfigValueId"
            }
          },
          "required": [
            "value"
          ]
        }
      ]
    },
    "SessionConfigValueId": {
      "description": "Unique identifier for a session configuration option value.",
      "type": "string"
    },
    "SkillId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "SkillPackId": {
      "type": "string",
      "maxLength": 21,
      "minLength": 21,
      "pattern": "^[A-Za-z0-9]{21}$"
    },
    "TextElement": {
      "type": "object",
      "properties": {
        "byte_range": {
          "$ref": "#/$defs/ByteRange"
        },
        "placeholder": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "byte_range"
      ]
    },
    "ThreadMode": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Message",
            "Agent"
          ]
        },
        {
          "description": "Compatibility default for pre-Epic-6 persisted and wire values. New\nuser-thread creation selects `Message` explicitly.",
          "type": "string",
          "const": "Chat"
        }
      ]
    },
    "TurnCLIRuntimeOptions": {
      "type": "object",
      "properties": {
        "acp_configuration": {
          "anyOf": [
            {
              "$ref": "#/$defs/AcpTurnConfiguration"
            },
            {
              "type": "null"
            }
          ]
        },
        "effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "personality": {
          "type": [
            "string",
            "null"
          ]
        },
        "sandbox": true,
        "steer_if_active": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "TurnCapability": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/TurnCapabilityKind"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "kind"
      ]
    },
    "TurnCapabilityKind": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "packId": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SkillPackId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "skillId": {
              "$ref": "#/$defs/SkillId"
            },
            "type": {
              "type": "string",
              "const": "skill"
            }
          },
          "required": [
            "type",
            "skillId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "packId": {
              "$ref": "#/$defs/SkillPackId"
            },
            "type": {
              "type": "string",
              "const": "skillPack"
            }
          },
          "required": [
            "type",
            "packId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "scopeKind": {
              "$ref": "#/$defs/McpScopeKind"
            },
            "type": {
              "type": "string",
              "const": "mcpServer"
            }
          },
          "required": [
            "type",
            "name",
            "scopeKind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "rawToolName": {
              "type": "string"
            },
            "scopeKind": {
              "$ref": "#/$defs/McpScopeKind"
            },
            "serverName": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "mcpTool"
            }
          },
          "required": [
            "type",
            "serverName",
            "rawToolName",
            "scopeKind"
          ]
        }
      ]
    },
    "TurnPermissionMode": {
      "type": "string",
      "enum": [
        "full_access",
        "auto_accept_edits",
        "supervised"
      ]
    },
    "TurnPermissionProfileSelection": {
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "#/$defs/TurnPermissionMode"
        }
      },
      "required": [
        "mode"
      ]
    },
    "TurnReasoningSelection": {
      "type": "object",
      "properties": {
        "effort": {
          "description": "String-valued because CLI runtimes may advertise efforts newer than\nPioneer API-provider adapters understand.",
          "type": "string"
        }
      },
      "required": [
        "effort"
      ]
    },
    "UserInput": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "textElements": {
              "type": "array",
              "default": [],
              "items": {
                "$ref": "#/$defs/TextElement"
              }
            },
            "type": {
              "type": "string",
              "const": "text"
            }
          },
          "required": [
            "type",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "image"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "url"
          ]
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "localImage"
            }
          },
          "required": [
            "type",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "file"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "url"
          ]
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "localFile"
            }
          },
          "required": [
            "type",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "audio"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "url"
          ]
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "localAudio"
            }
          },
          "required": [
            "type",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "video"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "url"
          ]
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "localVideo"
            }
          },
          "required": [
            "type",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "artifactId": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "artifact"
            },
            "versionId": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "type",
            "artifactId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "mention"
            }
          },
          "required": [
            "type",
            "name",
            "path"
          ]
        }
      ]
    }
  }
}